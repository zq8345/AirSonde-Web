---
import Base from '../layouts/Base.astro';
import { CAPABILITIES, CAPABILITIES_PAGE, META, SITE } from '../data/site';
import { breadcrumbSchema } from '../lib/jsonld';

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: `${SITE.url}/` },
    { name: 'Capabilities', url: `${SITE.url}/capabilities/` },
  ]),
];
---

<Base
  title={META.capabilities.title}
  description={META.capabilities.description}
  schemas={schemas}
>
  <section class="border-b border-white/10">
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20">
      <p class="text-sm font-semibold uppercase tracking-wider text-air-400">
        {CAPABILITIES_PAGE.eyebrow}
      </p>
      <h1
        class="mt-4 max-w-3xl text-3xl font-bold leading-tight tracking-tight text-ink-50 sm:text-4xl"
      >
        {CAPABILITIES_PAGE.heading}
      </h1>
      <p class="mt-5 max-w-2xl text-base leading-relaxed text-ink-300">{CAPABILITIES_PAGE.intro}</p>
    </div>
  </section>

  <section class="border-b border-white/10">
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8">
      <h2 class="text-2xl font-bold tracking-tight text-ink-50">{CAPABILITIES_PAGE.specHeading}</h2>
      <dl class="mt-10 grid gap-x-10 gap-y-8 sm:grid-cols-2">
        {
          CAPABILITIES.map((item) => (
            <div class="border-l-2 border-air-500/40 pl-5">
              <dt class="text-base font-semibold text-ink-50">{item.title}</dt>
              <dd class="mt-2 text-sm leading-relaxed text-ink-300">{item.body}</dd>
            </div>
          ))
        }
        <div class="border-l-2 border-air-500/40 pl-5">
          <dt class="text-base font-semibold text-ink-50">{CAPABILITIES_PAGE.branding.title}</dt>
          <dd class="mt-2 text-sm leading-relaxed text-ink-300">
            {CAPABILITIES_PAGE.branding.body}
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="border-b border-white/10">
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8">
      <h2 class="text-2xl font-bold tracking-tight text-ink-50">
        {CAPABILITIES_PAGE.processHeading}
      </h2>
      <ol class="mt-10 grid gap-6 sm:grid-cols-2">
        {
          CAPABILITIES_PAGE.steps.map((item) => (
            <li class="rounded-xl border border-white/10 bg-white/[0.02] p-6">
              <p class="text-sm font-semibold text-air-400">{item.step}</p>
              <h3 class="mt-2 text-lg font-semibold text-ink-50">{item.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-ink-300">{item.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section>
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8">
      <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-8 sm:p-12">
        <h2 class="text-2xl font-bold tracking-tight text-ink-50">{CAPABILITIES_PAGE.ctaHeading}</h2>
        <p class="mt-4 max-w-2xl text-sm leading-relaxed text-ink-300 sm:text-base">
          {CAPABILITIES_PAGE.ctaBody}
        </p>
        <a
          href={`mailto:${SITE.email}`}
          class="mt-8 inline-flex rounded-lg bg-air-500 px-6 py-3 text-sm font-semibold text-ink-950 transition-colors hover:bg-air-400"
        >
          {SITE.email}
        </a>
      </div>
    </div>
  </section>
</Base>
