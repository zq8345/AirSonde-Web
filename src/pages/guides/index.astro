---
/**
 * /guides/ — hub with the W5 batch-1 articles. The shell's noindex comes off
 * in this same commit (real content is here), and the sitemap filter in
 * astro.config.mjs goes with it.
 */
import LightBase from '../../layouts/LightBase.astro';
import { SITE } from '../../data/site';
import { GUIDES, GUIDES_HUB } from '../../data/guides';
import { breadcrumbSchema } from '../../lib/jsonld';

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: `${SITE.url}/` },
    { name: 'Guides', url: `${SITE.url}/guides/` },
  ]),
];
---

<LightBase title={GUIDES_HUB.meta.title} description={GUIDES_HUB.meta.description} schemas={schemas}>
  <section class="as-section" style="padding-bottom:48px">
    <div class="as-container as-pagehead">
      <p class="as-eyebrow">{GUIDES_HUB.eyebrow}</p>
      <h1 class="as-pagehead__title">{GUIDES_HUB.heading}</h1>
      <p class="as-pagehead__lead">{GUIDES_HUB.intro}</p>
    </div>
  </section>

  <section class="as-section" style="padding-top:0">
    <div class="as-container">
      <div class="as-ggrid">
        {
          GUIDES.map((guide) => (
            <a class="as-gcard" href={`/guides/${guide.slug}/`}>
              <span class="as-gcard__eyebrow">{guide.eyebrow}</span>
              <span class="as-gcard__title" style="display:block">{guide.title}</span>
              <span class="as-gcard__sum" style="display:block">{guide.description}</span>
              <span class="as-gcard__arw" aria-hidden="true">Read →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="as-section" style="padding-top:0">
    <div class="as-container">
      <div class="as-cta">
        <h2 class="as-cta__title">Have a question the guides should answer?</h2>
        <p class="as-cta__body">
          Tell us what you are trying to figure out — the next articles come from real enquiries.
        </p>
        <div class="as-cta__actions">
          <a href={`mailto:${SITE.email}`} class="as-btn as-btn--primary">{SITE.email}</a>
        </div>
      </div>
    </div>
  </section>
</LightBase>
