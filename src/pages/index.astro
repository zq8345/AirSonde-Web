---
/**
 * W4 light-theme homepage sample. Copy is rendered VERBATIM from site.ts —
 * the accepted assertions (OEM/ODM counts, banned-word zeros) live on that
 * text. New sections take their labels from home-light.ts only.
 */
import { Image } from 'astro:assets';
import LightBase from '../layouts/LightBase.astro';
import {
  CAPABILITIES,
  CONTACT,
  HERO,
  HOME_SECTIONS,
  META,
  SENSOR_CHIPS,
  SITE,
  VALUE_PROPS,
} from '../data/site';
import { FEATURED, FORM_FACTORS, HERO_PHOTO, HERO_PRODUCT, SCENES } from '../data/home-light';
import { categoryLabel, getPublishedProducts, resolveProductImage } from '../lib/products';

const products = await getPublishedProducts();
const bySlug = new Map(products.map((p) => [p.data.slug, p]));

const featured = FEATURED.slugs
  .map((slug) => bySlug.get(slug))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));

const formTiles = FORM_FACTORS.tiles.map((tile) => ({
  ...tile,
  count: products.filter((p) => p.data.category === tile.category).length,
  image: resolveProductImage(bySlug.get(tile.imageFrom)!.data.images.main),
}));

const heroProduct = bySlug.get(HERO_PRODUCT.slug)!;
const heroProductImage = resolveProductImage(heroProduct.data.images.main);
---

<LightBase title={META.home.title} description={META.home.description}>
  {/* 1 ── photo hero (§3.2d) */}
  <section class="as-hero" style={`--hero-focus: ${HERO_PHOTO.focus}`}>
    <Image
      src={HERO_PHOTO.src}
      alt={HERO_PHOTO.alt}
      class="as-hero__img"
      widths={[768, 1280, 1600]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="as-hero__wash" aria-hidden="true"></div>
    <div class="as-container as-hero__in">
      <div class="as-hero__text">
        <p class="as-hero__eyebrow">{HERO.eyebrow}</p>
        <h1 class="as-hero__title">
          <span class="as-hero__brand">{SITE.brand}</span> — {HERO.headline}
        </h1>
        <p class="as-hero__tagline">{HERO.tagline}</p>
        <p class="as-hero__body">{HERO.body}</p>
        <div class="as-hero__cta">
          <a href={HERO.primaryCta.href} class="as-btn as-btn--primary">
            {HERO.primaryCta.label}
            <span class="as-arw" aria-hidden="true">→</span>
          </a>
          <a href={HERO.secondaryCta.href} class="as-btn as-btn--ghost">{HERO.secondaryCta.label}</a>
        </div>
      </div>

      <a class="as-hero__product" href={`/products/${heroProduct.data.slug}`}>
        <span class="as-stage">
          <Image
            src={heroProductImage}
            alt={heroProduct.data.name}
            widths={[320, 480, 640]}
            sizes="(min-width: 768px) 300px, 230px"
            loading="eager"
          />
        </span>
        <span class="as-hero__product-meta">
          {heroProduct.data.model}
          <span class="as-arw" aria-hidden="true">→</span>
        </span>
      </a>
    </div>
  </section>

  {/* existing sensor-chip copy, restyled as a slim band */}
  <div class="as-container">
    <ul class="as-chips">
      {
        SENSOR_CHIPS.map((sensor) => (
          <li class="as-chip">
            <span class="as-chip__code">{sensor.code}</span>
            <span class="as-chip__label">{sensor.label}</span>
          </li>
        ))
      }
    </ul>
  </div>

  {/* 2 ── featured strip (curated, §3.6) */}
  <section class="as-section" id="featured">
    <div class="as-container">
      <div class="as-sechead">
        <p class="as-eyebrow">{FEATURED.eyebrow}</p>
        <h2 class="as-h2">{FEATURED.heading}</h2>
      </div>
      <div class="as-pgrid">
        {
          featured.map((product) => (
            <a
              class="as-pcard"
              href={`/products/${product.data.slug}`}
              data-as-reveal
            >
              <span class="as-stage">
                <Image
                  src={resolveProductImage(product.data.images.main)}
                  alt={product.data.name}
                  widths={[320, 480, 640]}
                  sizes="(min-width: 980px) 380px, (min-width: 560px) 45vw, 90vw"
                  loading="lazy"
                />
              </span>
              <span class="as-pcard__body">
                <span class="as-pcard__meta">
                  {categoryLabel(product.data.category)} · {product.data.model}
                </span>
                <span class="as-pcard__name">{product.data.name}</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {/* 3 ── browse by form factor */}
  <section class="as-section as-band--alt">
    <div class="as-container">
      <div class="as-sechead">
        <p class="as-eyebrow">{FORM_FACTORS.eyebrow}</p>
        <h2 class="as-h2">{FORM_FACTORS.heading}</h2>
      </div>
      <div class="as-forms">
        {
          formTiles.map((tile) => (
            <a class="as-form-tile" href="/products">
              <span class="as-stage">
                <Image src={tile.image} alt={tile.label} widths={[160, 240]} sizes="116px" loading="lazy" />
              </span>
              <span>
                <span class="as-form-tile__name">{tile.label}</span>
                <span class="as-form-tile__count">{tile.count} models</span>
              </span>
              <span class="as-form-tile__arw" aria-hidden="true">→</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {/* 4 ── scenes band */}
  <section class="as-section">
    <div class="as-container">
      <div class="as-sechead">
        <p class="as-eyebrow">{SCENES.eyebrow}</p>
        <h2 class="as-h2">{SCENES.heading}</h2>
      </div>
      <div class="as-scenes">
        {
          SCENES.cards.map((scene) => (
            <figure class="as-scene" data-as-reveal>
              <Image src={scene.src} alt={scene.alt} widths={[420, 640]} sizes="(min-width: 980px) 300px, (min-width: 560px) 45vw, 90vw" loading="lazy" />
              <figcaption class="as-scene__label">{scene.label}</figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  {/* 5 ── how we work with brands (existing copy) */}
  <section id={HOME_SECTIONS.whatWeDo.id} class="as-section as-band--alt">
    <div class="as-container">
      <div class="as-sechead">
        <h2 class="as-h2">{HOME_SECTIONS.whatWeDo.heading}</h2>
      </div>
      <div class="as-cards2">
        {
          VALUE_PROPS.map((prop) => (
            <article class="as-panelcard">
              <h3>{prop.title}</h3>
              <p>{prop.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* 6 ── what we can build (existing copy) */}
  <section id={HOME_SECTIONS.capabilities.id} class="as-section">
    <div class="as-container">
      <div class="as-sechead">
        <h2 class="as-h2">{HOME_SECTIONS.capabilities.heading}</h2>
        <p class="as-sub">{HOME_SECTIONS.capabilities.intro}</p>
      </div>
      <dl class="as-caps">
        {
          CAPABILITIES.map((item) => (
            <div class="as-cap">
              <dt>{item.title}</dt>
              <dd>{item.body}</dd>
            </div>
          ))
        }
      </dl>
      <p style="margin-top:40px">
        <a href="/capabilities" class="as-link-arrow">How a programme runs</a>
      </p>
    </div>
  </section>

  {/* 7 ── enquiry CTA (existing copy) */}
  <section id={HOME_SECTIONS.contact.id} class="as-section" style="padding-top:0">
    <div class="as-container">
      <div class="as-cta">
        <h2 class="as-cta__title">{CONTACT.title}</h2>
        <p class="as-cta__body">{CONTACT.body}</p>
        <div class="as-cta__actions">
          <a href={`mailto:${SITE.email}`} class="as-btn as-btn--primary">{SITE.email}</a>
          <a href="/contact" class="as-btn as-btn--ghost">What to send us</a>
        </div>
      </div>
    </div>
  </section>
</LightBase>
