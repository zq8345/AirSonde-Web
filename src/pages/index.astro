                <span class="as-pcard__name">{product.data.name}</span>
                {headlineSensors(product).length > 0 && (
                  <span class="as-pcard__chips">
                    {headlineSensors(product).map((chip) => (
                      <span>{chip}</span>
                    ))}
                  </span>
                )}
              </span>
            </a>
          ))
        }
      </div>
      <h3 class="as-h3 as-formrail__title">{PRODUCTS_HOME.formFactorHeading}</h3>
      <div class="as-forms">
        {
          /* W27: a vertical card. The name and the count are direct children
             of the tile, each its own block — as two inline spans with nothing
             between them they ran together as one text flow ("Desktop16
             models") and broke wherever the line ended.
             ⚠️ The count is a bare number now, so the link's accessible name
             would read "Desktop 16". The aria-label restores what the removed
             word carried; it is not rendered text. */
          formTiles.map((tile) => (
            <a class="as-form-tile" href="/products/" aria-label={`${tile.label} — ${tile.count} products`}>
              <span class="as-stage">
                <Image
                  src={tile.image}
                  alt=""
                  widths={[240, 360, 480]}
                  sizes="(min-width: 1024px) 240px, (min-width: 720px) 45vw, 90vw"
                  loading="lazy"
                />
