    <div class="as-container">
      <div class="as-sechead">
        <p class="as-eyebrow">{SCENES_HOME.eyebrow}</p>
        <h2 class="as-d2">{SCENES_HOME.heading}</h2>
        <p class="as-sub">{SCENES_HOME.sub}</p>
      </div>
      <div class="as-scenetabs" role="tablist" aria-label={SCENES_HOME.heading} data-as-scenes>
        {
          SCENES_DATA.map((scene, i) => (
            <button
              type="button"
              class:list={['as-scenetab', { 'is-active': i === 0 }]}
              role="tab"
              aria-selected={i === 0 ? 'true' : 'false'}
              data-scene={String(i)}
            >
              {scene.label}
            </button>
          ))
        }
      </div>
    </div>
    <div class="as-container">
      <div class="as-scenestage" data-as-scenes-stage>
        {
          SCENES_DATA.map((scene, i) => (
            <a
              class:list={['as-scenepanel', { 'is-active': i === 0 }]}
              data-scene={String(i)}
              href={`/solutions/${scene.slug}/`}
            >
              {/* W17 R1+Y7: every panel is lazy — the module sits at y≈2528,
                  so eager here only bought a 137KB first-screen bill (Y7).
                  Lazy alone is not enough either: the inactive panels are
                  display:none, and a lazy image in a hidden subtree is never
                  requested, not even after it is revealed (measured: no
                  network entry 4s after the tab was clicked). The tab script
                  kicks the fetch on activate/hover. */}
              {/* W39: per-scene framing — at 375 this panel shows only ~32%
                  of the 2.4:1 render's width, and the subjects sit in a
                  different place in each one. Inline object-position because
                  the img carries no other inline style and the value is data,
                  not skin. */}
              <Image
                src={scene.photo.src}
                alt={scene.photo.alt}
                widths={[1280, 1600]}
                sizes="(min-width: 1200px) 1140px, 94vw"
                loading="lazy"
                style={`object-position: ${scene.photo.panelFocus}`}
              />
              <span class="as-scenepanel__cap">
                <span class="as-scenepanel__eyebrow">{scene.label}</span>
                <span class="as-scenepanel__line">{scene.homeLine}</span>
                <span class="as-scenepanel__more">{SCENES_HOME.readMore} →</span>
              </span>
            </a>
          ))
        }
