---
/**
 * Homepage — W9: full-page mirror of wanew.com's eight-section skeleton
 * (structure/order/type tiers; light theme stays — 学骨架不学肤色).
 * Copy is rendered VERBATIM from site.ts / about.ts / solutions.ts /
 * guides.ts — the accepted assertions (OEM/ODM counts, banned-word zeros)
 * live on that text. Section labels come from home-light.ts only.
 */
import { Image } from 'astro:assets';
import LightBase from '../layouts/LightBase.astro';
import { CONTACT, FEATURED_SLUGS, HERO, HOME_SECTIONS, META, SENSOR_CHIPS, SITE, VALUE_PROPS } from '../data/site';
import {
  ABOUT_HOME,
  CTA_HOME,
  GUIDES_HOME,
  HERO_PHOTO,
  PRODUCTS_HOME,
  SCENES_HOME,
  WHY_HOME,
} from '../data/home-light';
import { ABOUT_EXPECT, ABOUT_HERO, ABOUT_QUALITY, ABOUT_STATS } from '../data/about';
import { SCENES_DATA } from '../data/solutions';
import { GUIDES } from '../data/guides';
import {
  categoryLabel,
  getPublishedProducts,
  headlineSensors,
  productHref,
  resolveProductImage,
} from '../lib/products';
import factoryPhoto from '../assets/photos/factory/factory-assembly.webp';

const products = await getPublishedProducts();
const bySlug = new Map(products.map((p) => [p.data.slug, p]));

/**
 * W25: the featured set comes from site-content.json, which the admin can
 * write; the array's order is the display order and the count is not fixed at
 * eight — the grid flows.
 * ⚠️ A slug that matches nothing is skipped rather than failing the build:
 * unpublishing a product from the admin must never take the site's build down.
 * But it used to be skipped in silence, which meant the homepage could quietly
 * drop to seven tiles with nobody told. It says which ones now.
 */
const missingFeatured = FEATURED_SLUGS.filter((slug) => !bySlug.has(slug));
if (missingFeatured.length > 0) {
  console.warn(
    `[home] ${missingFeatured.length} featured slug(s) in site-content.json match no published product and will not render: ${missingFeatured.join(', ')}`,
  );
}
const curated = FEATURED_SLUGS.map((slug) => bySlug.get(slug)).filter(
  (p): p is NonNullable<typeof p> => Boolean(p),
);

/* §3 tiles grow from the live categories — never hardcoded */
const categories = [...new Set(products.map((p) => p.data.category))];
const formTiles = categories.map((category) => {
  const preferred = PRODUCTS_HOME.formFactorImages[category];
  const rep = (preferred && bySlug.get(preferred)) || products.find((p) => p.data.category === category)!;
  return {
    category,
    label: categoryLabel(category),
    count: products.filter((p) => p.data.category === category).length,
    image: resolveProductImage(rep.data.images.main),
  };
});

/* §5 — wanew shows four stats; ours are the About page's first four (同源) */
const homeStats = ABOUT_STATS.items.slice(0, 4);

/* §6 — four cards composed from existing verified sentences only */
const whyCards = [
  ...VALUE_PROPS.map((p) => ({ title: p.title, body: p.body })),
  { title: WHY_HOME.qualityTitle, body: ABOUT_QUALITY.intro },
  { title: WHY_HOME.supportTitle, body: `${ABOUT_EXPECT.items[0]} ${ABOUT_EXPECT.items[1]}` },
];
---

<LightBase title={META.home.title} description={META.home.description}>
  {/* 1 ── hero. banner-split (七条之2, 图归图字归字): the image runs
      full-bleed with nothing on it — product and scene untouched — and the
      positioning copy sits below at its full display tier. Other modes keep
      the overlay hero. */}
  {
    HERO_PHOTO.mode === 'banner-over' ? (
      /* Joe: copy sits ON the image, stepped down, headline in exactly two
         lines — split on the comma so the break is data-driven, not a manual
         <br> that would rot if the sentence changes. */
      <section class="as-heroover" style={`--hero-focus: ${HERO_PHOTO.focus}`}>
        <Image
          src={HERO_PHOTO.src}
          alt={HERO_PHOTO.alt}
          class="as-heroover__img"
          widths={[768, 1280, 1600, 2400]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
        />
        <div class="as-heroover__scrim" aria-hidden="true"></div>
        {/* Joe: eyebrow pill and the CTA pair come off the hero — headline and
            one subline only, sitting lower on the wall. */}
        <div class="as-container as-heroover__in">
          <div class="as-heroover__text">
            <h1 class="as-heroover__title">
              {HERO.headline.split(/,\s+/).map((line, i, all) => (
                <span class="as-heroover__line">{i < all.length - 1 ? `${line},` : line}</span>
              ))}
            </h1>
            <p class="as-heroover__sub">{HERO.body}</p>
          </div>
        </div>
      </section>
    ) : HERO_PHOTO.mode === 'banner-split' || HERO_PHOTO.mode === 'banner-under' ? (
      <>
        <section
          class:list={['as-herosplit', { 'as-herosplit--under': HERO_PHOTO.mode === 'banner-under' }]}
          style={`--hero-focus: ${HERO_PHOTO.focus}`}
        >
          <Image
            src={HERO_PHOTO.src}
            alt={HERO_PHOTO.alt}
            class="as-herosplit__img"
            widths={[768, 1280, 1600, 2400]}
            sizes="100vw"
            loading="eager"
            fetchpriority="high"
          />
        </section>
        <section class="as-herosplit__copy">
          <div class="as-container">
            <p class="as-hero__eyebrow">{HERO.eyebrow}</p>
            <h1 class="as-herosplit__title">{HERO.headline}</h1>
            <p class="as-hero__sub">{HERO.body}</p>
            <div class="as-hero__cta">
              <a href={HERO.primaryCta.href} class="as-btn as-btn--primary">
                {HERO.primaryCta.label}
                <span class="as-arw" aria-hidden="true">→</span>
              </a>
              <a href={HERO.secondaryCta.href} class="as-btn as-btn--ghost">{HERO.secondaryCta.label}</a>
            </div>
          </div>
        </section>
      </>
    ) : (
      <section
        class:list={[
          'as-hero',
          {
            'as-hero--banner': HERO_PHOTO.mode === 'banner',
            'as-hero--bannerclean': HERO_PHOTO.mode === 'banner-clean',
          },
        ]}
        style={`--hero-focus: ${HERO_PHOTO.focus}`}
      >
        <Image
          src={HERO_PHOTO.src}
          alt={HERO_PHOTO.alt}
          class="as-hero__img"
          widths={[768, 1280, 1600]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
        />
        <div class="as-hero__wash" aria-hidden="true" />
        <div class="as-container as-hero__in">
          <div class="as-hero__text">
            <p class="as-hero__eyebrow">{HERO.eyebrow}</p>
            <h1 class="as-hero__title">{HERO.headline}</h1>
            <p class="as-hero__sub">{HERO.body}</p>
            <div class="as-hero__cta">
              <a href={HERO.primaryCta.href} class="as-btn as-btn--primary">
                {HERO.primaryCta.label}
                <span class="as-arw" aria-hidden="true">→</span>
              </a>
              <a href={HERO.secondaryCta.href} class="as-btn as-btn--ghost">{HERO.secondaryCta.label}</a>
            </div>
          </div>
        </div>
      </section>
    )
  }

  {/* sensor-chip band — kept under the hero (not a wanew section; it carries
      the sensing enumeration that left the hero tagline) */}
  <div class="as-container">
    <ul class="as-chips">
      {
        SENSOR_CHIPS.map((sensor) => (
          <li class="as-chip">
            <span class="as-chip__code">{sensor.code}</span>
            <span class="as-chip__label">{sensor.label}</span>
          </li>
        ))
      }
    </ul>
  </div>

  {/* 2+3 ── products: curated eight, 2×4, All-products top-right; form-factor
      rail is an h3 subsection INSIDE this block (wanew: 先看货,机型是另一条路) */}
  <section class="as-section" id="featured">
    <div class="as-container">
      <div class="as-sechead as-sechead--row">
        <div>
          <p class="as-eyebrow">{PRODUCTS_HOME.eyebrow}</p>
          <h2 class="as-d2">{PRODUCTS_HOME.heading}</h2>
        </div>
        <a class="as-link-arrow" href="/products/">{PRODUCTS_HOME.allLink}</a>
      </div>
      <div class="as-pgrid as-pgrid--4">
        {
          curated.map((product) => (
            <a class="as-pcard" href={productHref(product)} data-as-reveal>
              <span class="as-stage">
                <Image
                  src={resolveProductImage(product.data.images.main)}
                  alt={product.data.name}
                  widths={[320, 480, 640]}
                  sizes="(min-width: 980px) 280px, (min-width: 560px) 45vw, 90vw"
                  loading="lazy"
                />
              </span>
              <span class="as-pcard__body">
                <span class="as-pcard__meta">
                  {categoryLabel(product.data.category)} · {product.data.model}
                </span>
                <span class="as-pcard__name">{product.data.name}</span>
                {headlineSensors(product).length > 0 && (
                  <span class="as-pcard__chips">
                    {headlineSensors(product).map((chip) => (
                      <span>{chip}</span>
                    ))}
                  </span>
                )}
              </span>
            </a>
          ))
        }
      </div>
      <h3 class="as-h3 as-formrail__title">{PRODUCTS_HOME.formFactorHeading}</h3>
      <div class="as-forms">
        {
          /* W27: a vertical card. The name and the count are direct children
             of the tile, each its own block — as two inline spans with nothing
             between them they ran together as one text flow ("Desktop16
             models") and broke wherever the line ended.
             ⚠️ The count is a bare number now, so the link's accessible name
             would read "Desktop 16". The aria-label restores what the removed
             word carried; it is not rendered text. */
          formTiles.map((tile) => (
            <a class="as-form-tile" href="/products/" aria-label={`${tile.label} — ${tile.count} products`}>
              <span class="as-stage">
                <Image
                  src={tile.image}
                  alt=""
                  widths={[240, 360, 480]}
                  sizes="(min-width: 1024px) 240px, (min-width: 720px) 45vw, 90vw"
                  loading="lazy"
                />
              </span>
              <span class="as-form-tile__name">{tile.label}</span>
              <span class="as-form-tile__count">{tile.count}</span>
              <span class="as-form-tile__arw" aria-hidden="true">→</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {/* 4 ── scene tabs + one big panel (W8 spec, wanew "For every environment").
      wanew separates same-bg sections with hairlines; our light constitution
      (§3.2c) forbids hairlines — tonal alternation carries the separation. */}
  <section class="as-section as-band--alt">
    <div class="as-container">
      <div class="as-sechead">
        <p class="as-eyebrow">{SCENES_HOME.eyebrow}</p>
        <h2 class="as-d2">{SCENES_HOME.heading}</h2>
        <p class="as-sub">{SCENES_HOME.sub}</p>
      </div>
      <div class="as-scenetabs" role="tablist" aria-label={SCENES_HOME.heading} data-as-scenes>
        {
          SCENES_DATA.map((scene, i) => (
            <button
              type="button"
              class:list={['as-scenetab', { 'is-active': i === 0 }]}
              role="tab"
              aria-selected={i === 0 ? 'true' : 'false'}
              data-scene={String(i)}
            >
              {scene.label}
            </button>
          ))
        }
      </div>
    </div>
    <div class="as-container">
      <div class="as-scenestage" data-as-scenes-stage>
        {
          SCENES_DATA.map((scene, i) => (
            <a
              class:list={['as-scenepanel', { 'is-active': i === 0 }]}
              data-scene={String(i)}
              href={`/solutions/${scene.slug}/`}
            >
              {/* W17 R1+Y7: every panel is lazy — the module sits at y≈2528,
                  so eager here only bought a 137KB first-screen bill (Y7).
                  Lazy alone is not enough either: the inactive panels are
                  display:none, and a lazy image in a hidden subtree is never
                  requested, not even after it is revealed (measured: no
                  network entry 4s after the tab was clicked). The tab script
                  kicks the fetch on activate/hover. */}
              <Image
                src={scene.photo.src}
                alt={scene.photo.alt}
                widths={[1280, 1600]}
                sizes="(min-width: 1200px) 1140px, 94vw"
                loading="lazy"
              />
              <span class="as-scenepanel__cap">
                <span class="as-scenepanel__eyebrow">{scene.label}</span>
                <span class="as-scenepanel__line">{scene.homeLine}</span>
                <span class="as-scenepanel__more">{SCENES_HOME.readMore} →</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {/* 5 ── about band (wanew "We make what we sell"): head full-width, photo
      left, copy + four stats right — facts imported from about.ts (同源) */}
  <section class="as-section">
    <div class="as-container">
      <div class="as-abhead">
        <p class="as-eyebrow">{ABOUT_HOME.eyebrow}</p>
        <h2 class="as-d2">{ABOUT_HERO.heading}</h2>
      </div>
      <div class="as-abgrid">
        <div class="as-abgrid__media">
          <Image
            src={factoryPhoto}
            alt={ABOUT_HERO.photo.alt}
            widths={[640, 960]}
            sizes="(min-width: 980px) 540px, 94vw"
            loading="lazy"
          />
        </div>
        <div>
          <p class="as-sub">{ABOUT_HERO.lead}</p>
          <div class="as-stats as-stats--home">
            {
              homeStats.map((s) => (
                <div class="as-stat">
                  <div class="as-stat__value">{s.value}</div>
                  <div class="as-stat__label">{s.label}</div>
                </div>
              ))
            }
          </div>
          <a href="/about/" class="as-link-arrow">{ABOUT_HOME.learnMore}</a>
        </div>
      </div>
    </div>
  </section>

  {/* 6 ── why band (wanew "Our Advantages"), four cards from existing copy.
      🔴 wanew's FCC/CE/RoHS cert strip is NOT ported — zero-cert red line. */}
  <section id={HOME_SECTIONS.capabilities.id} class="as-section as-band--alt">
    <div class="as-container">
      <div class="as-sechead">
        <p class="as-eyebrow">{WHY_HOME.eyebrow}</p>
        <h2 class="as-d2">{WHY_HOME.heading}</h2>
        <p class="as-sub">{HOME_SECTIONS.capabilities.intro}</p>
      </div>
      <div class="as-why">
        {
          whyCards.map((card) => (
            <article class="as-whycard">
              <h3>{card.title}</h3>
              <p>{card.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* 7 ── guides (three W5 articles), same card language as /guides/ */}
  <section class="as-section">
    <div class="as-container">
      <div class="as-sechead">
        <p class="as-eyebrow">{GUIDES_HOME.eyebrow}</p>
        <h2 class="as-d2">{GUIDES_HOME.heading}</h2>
      </div>
      <div class="as-ggrid">
        {
          GUIDES.map((guide) => (
            <a class="as-gcard" href={`/guides/${guide.slug}/`}>
              <span class="as-gcard__eyebrow">{guide.eyebrow}</span>
              <span class="as-gcard__title" style="display:block">{guide.title}</span>
              <span class="as-gcard__sum" style="display:block">{guide.description}</span>
              <span class="as-gcard__arw" aria-hidden="true">Read →</span>
            </a>
          ))
        }
      </div>
      <p style="margin-top:32px">
        <a class="as-link-arrow" href="/guides/">{GUIDES_HOME.viewAll} →</a>
      </p>
    </div>
  </section>

  {/* 8 ── contact CTA band — wires into the W7 form on /contact/ */}
  <section id={HOME_SECTIONS.contact.id} class="as-section" style="padding-top:0">
    <div class="as-container">
      <div class="as-cta">
        <p class="as-eyebrow">{CTA_HOME.eyebrow}</p>
        <h2 class="as-cta__title as-d2">{CONTACT.title}</h2>
        <p class="as-cta__body">{CONTACT.body}</p>
        <div class="as-cta__actions">
          <a href={HERO.primaryCta.href} class="as-btn as-btn--primary">
            {HERO.primaryCta.label}
            <span class="as-arw" aria-hidden="true">→</span>
          </a>
          <a href={`mailto:${SITE.email}`} class="as-btn as-btn--ghost">{SITE.email}</a>
        </div>
      </div>
    </div>
  </section>
</LightBase>

<script>
  // W9 §4 scene tabs — same behaviour as wanew's (user-driven, no auto-rotate)
  const wrap = document.querySelector('[data-as-scenes]');
  const stage = document.querySelector('[data-as-scenes-stage]');
  if (wrap && stage) {
    const tabs = wrap.querySelectorAll<HTMLButtonElement>('.as-scenetab');
    const panels = stage.querySelectorAll<HTMLElement>('.as-scenepanel');

    /**
     * A lazy <img> inside a display:none subtree is never requested, and
     * revealing it does not start the request either — the panel just showed
     * its scrim over nothing. Kick the fetch ourselves when a panel is about
     * to be shown (and on hover, so the image is usually there by the click).
     */
    const ensureLoaded = (panel: HTMLElement | null) => {
      const img = panel?.querySelector<HTMLImageElement>('img');
      if (!img || img.complete) return;
      img.loading = 'eager';
      const { src, srcset } = img;
      if (srcset) img.srcset = srcset;
      img.src = src;
    };
    const panelFor = (id: string | null) =>
      [...panels].find((p) => p.getAttribute('data-scene') === id) ?? null;

    tabs.forEach((tab) => {
      const id = tab.getAttribute('data-scene');
      tab.addEventListener('pointerenter', () => ensureLoaded(panelFor(id)));
      tab.addEventListener('click', () => {
        ensureLoaded(panelFor(id));
        tabs.forEach((t) => {
          const on = t === tab;
          t.classList.toggle('is-active', on);
          t.setAttribute('aria-selected', String(on));
        });
        panels.forEach((p) => {
          p.classList.toggle('is-active', p.getAttribute('data-scene') === id);
        });
      });
    });
  }
</script>
