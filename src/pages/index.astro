          <a href="/about/" class="as-link-arrow">{ABOUT_HOME.learnMore}</a>
        </div>
      </div>
    </div>
  </section>

  {/* 6 ── why band, rebuilt (W41-A, 宪法 §5): answers the direct-sourcing
      question with four numbered arguments composed from published facts.
      🔴 wanev's FCC/CE/RoHS cert strip is still NOT ported — zero-cert red
      line stands; card 03 says exactly what the About compliance section
      says and nothing more. The admin's capabilities intro keeps its slot. */}
  <section id={HOME_SECTIONS.capabilities.id} class="as-section as-band--alt">
    <div class="as-container">
      <div class="as-sechead">
        <p class="as-eyebrow">{WHY_HOME.eyebrow}</p>
        <h2 class="as-d2">{WHY_HOME.heading}</h2>
        <p class="as-sub">{whyLead}</p>
        <p class="as-sub">{HOME_SECTIONS.capabilities.intro}</p>
      </div>
      <div class="as-why">
        {
          whyCards.map((card) => (
            <article class="as-whycard">
              <p class="as-eyebrow as-whycard__no">{card.no}</p>
              <h3>{card.title}</h3>
              <p>{card.body}</p>
            </article>
