---
/**
 * Homepage — W9: full-page mirror of wanew.com's eight-section skeleton
 * (structure/order/type tiers; light theme stays — 学骨架不学肤色).
 * Copy is rendered VERBATIM from site.ts / about.ts / solutions.ts /
 * guides.ts — the accepted assertions (OEM/ODM counts, banned-word zeros)
 * live on that text. Section labels come from home-light.ts only.
 */
import { Image } from 'astro:assets';
import LightBase from '../layouts/LightBase.astro';
import { CONTACT, FEATURED_SLUGS, HERO, HOME_SECTIONS, META, SENSOR_CHIPS, SITE, VALUE_PROPS } from '../data/site';
import {
  ABOUT_HOME,
  CTA_HOME,
  GUIDES_HOME,
  HERO_PHOTO,
  PRODUCTS_HOME,
  SCENES_HOME,
  WHY_HOME,
} from '../data/home-light';
import { ABOUT_EXPECT, ABOUT_HERO, ABOUT_STATS, ABOUT_STORY } from '../data/about';
import { SCENES_DATA } from '../data/solutions';
import { GUIDES } from '../data/guides';
import {
  categoryLabel,
  getPublishedProducts,
  headlineSensors,
  productHref,
  resolveProductImage,
} from '../lib/products';
import factoryPhoto from '../assets/photos/factory/factory-assembly.webp';

const products = await getPublishedProducts();
const bySlug = new Map(products.map((p) => [p.data.slug, p]));

/**
 * W25: the featured set comes from site-content.json, which the admin can
 * write; the array's order is the display order and the count is not fixed at
 * eight — the grid flows.
 * ⚠️ A slug that matches nothing is skipped rather than failing the build:
 * unpublishing a product from the admin must never take the site's build down.
 * But it used to be skipped in silence, which meant the homepage could quietly
 * drop to seven tiles with nobody told. It says which ones now.
 */
const missingFeatured = FEATURED_SLUGS.filter((slug) => !bySlug.has(slug));
if (missingFeatured.length > 0) {
  console.warn(
    `[home] ${missingFeatured.length} featured slug(s) in site-content.json match no published product and will not render: ${missingFeatured.join(', ')}`,
  );
}
const curated = FEATURED_SLUGS.map((slug) => bySlug.get(slug)).filter(
  (p): p is NonNullable<typeof p> => Boolean(p),
);

/* §3 tiles grow from the live categories — never hardcoded */
const categories = [...new Set(products.map((p) => p.data.category))];
const formTiles = categories.map((category) => {
  const preferred = PRODUCTS_HOME.formFactorImages[category];
  const rep = (preferred && bySlug.get(preferred)) || products.find((p) => p.data.category === category)!;
  return {
    category,
    label: categoryLabel(category),
    count: products.filter((p) => p.data.category === category).length,
    image: resolveProductImage(rep.data.images.main),
  };
});

/* §5 — W41-B (审查问题 E): the six About numbers were repeated wholesale here.
   Three hardest stay — years, staff, monthly capacity — the photo and the
   /about/ link carry the rest. About keeps the full set, untouched. */
const homeStats = [ABOUT_STATS.items[0], ABOUT_STATS.items[1], ABOUT_STATS.items[4]];

/* §6 — W41-A (宪法 §5): the section answers "why not source the same-looking
   unit from a marketplace listing?". 🔴 红线纪律: every factual sentence below
   is a published sentence from about.ts / site.ts, verbatim or tightened —
   zero new fact claims. The framing question and card titles are positioning
   copy (站方定位), which is this window's to draft and 总工's to strike.
   ⚠️ Dropped from the brief: "English-speaking engineering contact" — no page
   publishes that claim today, so it does not get invented here. */
const whyLead = 'The question behind every sourcing decision: what do you get here that a marketplace listing cannot give you?';
const whyCards = [
  {
    no: '01',
    title: 'You deal with the factory itself',
    // published: site default description == ABOUT_HERO lead (about.ts)
    body: 'AirSonde is the indoor air quality product line of an established Shenzhen manufacturing group: 15+ years of OEM/ODM production, 150+ staff, in-house tooling, assembly and QC.',
  },
  {
    no: '02',
    title: 'An engineer answers',
    // published: ABOUT_EXPECT items 1+2, verbatim
    body: `${ABOUT_EXPECT.items[0]} ${ABOUT_EXPECT.items[1]}`,
  },
  {
    no: '03',
    title: 'Specifications you can defend',
    // published: ABOUT_PROCESS step 03 + ABOUT_COMPLIANCE, tightened
    body: 'The specification is fixed in writing before anything is built. Certification is scoped per programme and per model — the route your market requires is agreed in writing first.',
  },
  {
    no: '04',
    title: 'Built under your name, as deep as you need',
    // composed FROM the admin's VALUE_PROPS (not copied): this section is now
    // the field's only consumer, and hardcoding the sentences here would turn
    // home.valueProps into a dead admin field — the exact failure site.ts
    // warns about. The join adds only the ODM depth list from ABOUT_SERVICES.
    body: `${VALUE_PROPS[1].body.replace(/\.\s*$/, '')} — sensing set, enclosure, display and firmware. ${VALUE_PROPS[0].body}`,
  },
];
/* published verbatim: ABOUT_STORY.paragraphs[0] — the section's closing line */
const whyCoda = ABOUT_STORY.paragraphs[0];
---

<LightBase title={META.home.title} description={META.home.description}>
  {/* 1 ── hero. banner-split (七条之2, 图归图字归字): the image runs
      full-bleed with nothing on it — product and scene untouched — and the
      positioning copy sits below at its full display tier. Other modes keep
      the overlay hero. */}
  {
    HERO_PHOTO.mode === 'banner-over' ? (
      /* Joe: copy sits ON the image, stepped down, headline in exactly two
         lines — split on the comma so the break is data-driven, not a manual
         <br> that would rot if the sentence changes. */
      <section
        class="as-heroover"
        style={`--hero-focus: ${HERO_PHOTO.focus}; --hero-focus-narrow: ${HERO_PHOTO.focusNarrow ?? HERO_PHOTO.focus}`}
      >
        <Image
          src={HERO_PHOTO.src}
          alt={HERO_PHOTO.alt}
          class="as-heroover__img"
          widths={[768, 1280, 1600, 2400]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
        />
        <div class="as-heroover__scrim" aria-hidden="true"></div>
        {/* Joe: eyebrow pill and the CTA pair come off the hero — headline and
            one subline only, sitting lower on the wall. */}
        <div class="as-container as-heroover__in">
          <div class="as-heroover__text">
            <h1 class="as-heroover__title">
              {HERO.headline.split(/,\s+/).map((line, i, all) => (
                <span class="as-heroover__line">{i < all.length - 1 ? `${line},` : line}</span>
              ))}
            </h1>
            <p class="as-heroover__sub">{HERO.body}</p>
          </div>
        </div>
      </section>
    ) : HERO_PHOTO.mode === 'side' ? (
      /* W44 方案 2 (Joe「你先试试」): 图文分离 — the copy stands on the page
         background inside the grid, the image is its own cover panel on the
         right (below on phones). Zero wash, zero text-over-image: contrast
         stops being a function of the photograph entirely. */
      <section
        class="as-heroside"
        style={`--hero-focus: ${HERO_PHOTO.focus}; --hero-focus-narrow: ${HERO_PHOTO.focusNarrow ?? HERO_PHOTO.focus}`}
      >
        <div class="as-container as-heroside__grid">
          <div class="as-heroside__text">
            <p class="as-hero__eyebrow">{HERO.eyebrow}</p>
            <h1 class="as-heroside__title">
              {HERO.headline.split(/,\s+/).map((line, i, all) => (
                <span class="as-heroside__line">{i < all.length - 1 ? `${line},` : line}</span>
              ))}
            </h1>
            <p class="as-hero__sub">{HERO.body}</p>
            <div class="as-hero__cta">
              <a href={HERO.primaryCta.href} class="as-btn as-btn--primary">
                {HERO.primaryCta.label}
                <span class="as-arw" aria-hidden="true">→</span>
              </a>
              <a href={HERO.secondaryCta.href} class="as-btn as-btn--ghost">{HERO.secondaryCta.label}</a>
            </div>
          </div>
          <div class="as-heroside__media">
            <Image
              src={HERO_PHOTO.src}
              alt={HERO_PHOTO.alt}
              class="as-heroside__img"
              widths={[768, 1280, 1600, 2400]}
              sizes="(min-width: 980px) 54vw, 94vw"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </div>
      </section>
    ) : HERO_PHOTO.mode === 'banner-split' || HERO_PHOTO.mode === 'banner-under' ? (
      <>
        <section
          class:list={['as-herosplit', { 'as-herosplit--under': HERO_PHOTO.mode === 'banner-under' }]}
          style={`--hero-focus: ${HERO_PHOTO.focus}`}
        >
          <Image
            src={HERO_PHOTO.src}
            alt={HERO_PHOTO.alt}
            class="as-herosplit__img"
            widths={[768, 1280, 1600, 2400]}
            sizes="100vw"
            loading="eager"
            fetchpriority="high"
          />
        </section>
        <section class="as-herosplit__copy">
          <div class="as-container">
            <p class="as-hero__eyebrow">{HERO.eyebrow}</p>
            <h1 class="as-herosplit__title">{HERO.headline}</h1>
            <p class="as-hero__sub">{HERO.body}</p>
            <div class="as-hero__cta">
              <a href={HERO.primaryCta.href} class="as-btn as-btn--primary">
                {HERO.primaryCta.label}
                <span class="as-arw" aria-hidden="true">→</span>
              </a>
              <a href={HERO.secondaryCta.href} class="as-btn as-btn--ghost">{HERO.secondaryCta.label}</a>
            </div>
          </div>
        </section>
      </>
    ) : (
      <section
        class:list={[
          'as-hero',
          {
            'as-hero--banner': HERO_PHOTO.mode === 'banner',
            'as-hero--bannerclean': HERO_PHOTO.mode === 'banner-clean',
          },
        ]}
        style={`--hero-focus: ${HERO_PHOTO.focus}`}
      >
        <Image
          src={HERO_PHOTO.src}
          alt={HERO_PHOTO.alt}
          class="as-hero__img"
          widths={[768, 1280, 1600]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
        />
        <div class="as-hero__wash" aria-hidden="true" />
        <div class="as-container as-hero__in">
          <div class="as-hero__text">
            <p class="as-hero__eyebrow">{HERO.eyebrow}</p>
            <h1 class="as-hero__title">{HERO.headline}</h1>
            <p class="as-hero__sub">{HERO.body}</p>
            <div class="as-hero__cta">
              <a href={HERO.primaryCta.href} class="as-btn as-btn--primary">
                {HERO.primaryCta.label}
                <span class="as-arw" aria-hidden="true">→</span>
              </a>
              <a href={HERO.secondaryCta.href} class="as-btn as-btn--ghost">{HERO.secondaryCta.label}</a>
            </div>
          </div>
        </div>
      </section>
    )
  }

  {/* sensor-chip band — kept under the hero (not a wanew section; it carries
      the sensing enumeration that left the hero tagline) */}
  <div class="as-container">
    <ul class="as-chips">
      {
        SENSOR_CHIPS.map((sensor) => (
          <li class="as-chip">
            <span class="as-chip__code">{sensor.code}</span>
            <span class="as-chip__label">{sensor.label}</span>
          </li>
