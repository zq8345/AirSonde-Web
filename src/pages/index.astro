---
/**
 * Homepage v4 — implemented from airsonde-design/home-v4.html (Joe 逐屏验收
 * 2026-09-05), section for section. Copy lives in site-content.json
 * (`homeV4`, admin-writable); structure, order, colours, type, crop
 * parameters and every href live here (DESIGN.md §9).
 *
 * Facts stay single-sourced: factory numbers come from about.ts
 * (ABOUT_STATS, Joe-authorised), scene photos from solutions.ts, guides from
 * guides.ts, products from the catalogue by slug. Nothing here invents a
 * number or a claim the site does not already publish.
 */
import { Image } from 'astro:assets';
import HomeLayout from '../layouts/HomeLayout.astro';
import { HOME_V4, META, SITE } from '../data/site';
import { ABOUT_HERO } from '../data/about';
import { sensorGroupsFor } from '../lib/catalog-filters';
import { SCENES_DATA } from '../data/solutions';
import { GUIDES } from '../data/guides';
import { getPublishedProducts, productHref, resolveProductImage } from '../lib/products';
import heroImg from '../assets/photos/home-hero-ak34-family-v2.webp';
import facAssembly from '../assets/photos/factory/factory-assembly.webp';
import facCnc from '../assets/photos/factory/factory-cnc.webp';
import facQc from '../assets/photos/factory/factory-qc.webp';
import facWarehouse from '../assets/photos/factory/factory-warehouse.webp';
import facShipping from '../assets/photos/factory/factory-shipping.webp';

const V = HOME_V4;

/* products: featured list is admin data (slug + tagline + chips); image and
   model resolve from the catalogue. An unknown or unpublished slug renders
   one card fewer and is named at build time — never a blank card. */
const products = await getPublishedProducts();
const bySlug = new Map(products.map((p) => [p.data.slug, p]));
const featured = V.products.featured
  .map((f) => {
    const p = bySlug.get(f.slug);
    if (!p) {
      console.warn(`[home] featured slug "${f.slug}" is not a published product — card skipped`);
      return null;
    }
    return { ...f, product: p, image: resolveProductImage(p.data.images.main), href: productHref(p) };
  })
  .filter((x): x is NonNullable<typeof x> => x !== null);
const rows = [featured.slice(0, 3), featured.slice(3, 6)].filter((r) => r.length > 0);

/* scenes: crop parameters are design-locked (DESIGN.md §9 半配置: photo swap
   is allowed, framing is not). --po = expanded panel, --pc = collapsed. */
const SCENE_FOCUS: Record<string, { po: string; pc: string }> = {
  home: { po: '62%', pc: '56%' },
  office: { po: '72%', pc: '79%' },
  school: { po: '74%', pc: '86%' },
  industrial: { po: '70%', pc: '68%' },
};
const scenes = SCENES_DATA.map((s) => ({
  ...s,
  line: (V.solutions.lines as Record<string, string>)[s.slug] ?? s.homeLine,
  focus: SCENE_FOCUS[s.slug] ?? { po: '50%', pc: '50%' },
}));

/* factory floor: five reviewed photos, captions from copy */
const floor = [
  { key: 'assembly', src: facAssembly, alt: 'Assembly line' },
  { key: 'cnc', src: facCnc, alt: 'Machining hall' },
  { key: 'qc', src: facQc, alt: 'QC test bench' },
  { key: 'warehouse', src: facWarehouse, alt: 'Warehouse' },
  { key: 'shipping', src: facShipping, alt: 'Dispatch' },
].map((f) => ({ ...f, caption: (V.factory.floor as Record<string, string>)[f.key] ?? f.alt }));

/* stats: one admin-editable array (value + label per entry), shared with /about/ */
const stats = V.factory.stats;

/* hero marquee: the same derivation as the /products/ sensor filter row (Joe 2026-09-05) —
   the admin's sensor table (taxonomy.json), its order and labels, only values a published
   product carries. No hand-written chip list anywhere. */
const marquee = sensorGroupsFor(products);

const guides = GUIDES.slice(0, 3);

/* hand-drawn line icons (DESIGN.md §7: stroke 1.8, round caps, 24 viewBox) */
const ICONS: Record<string, string> = {
  factory: 'M3 21V9l6 3V9l6 3V5.5L21 4v17M3 21h18M7 17h2m4 0h2',
  chat: 'M4 6h16v10H9l-5 4V6zM8 11h.01M12 11h.01M16 11h.01',
  doc: 'M7 3h8l4 4v14H7V3zM15 3v4h4M10 13l2 2 4-4',
  star: 'M12 3l2 4 4.5.6-3.2 3.2.8 4.5-4.1-2.2-4.1 2.2.8-4.5L5.5 7.6 10 7l2-4zM8 21h8',
  send: 'M21 3L10 14M21 3l-7 18-4-7-7-4 18-7z',
  reply: 'M4 6h16v10H9l-5 4V6zM8 11h8',
  box: 'M21 8l-9-5-9 5v8l9 5 9-5V8zM3 8l9 5m0 0l9-5m-9 5v9',
};
---

<HomeLayout title={META.home.title} description={META.home.description}>
  {/* ① HERO — full-bleed image, dark-green veil, H1 + two CTAs, sensor marquee */}
  <div class="hero">
    <Image
      src={heroImg}
      alt="AK34 monitor on a coffee table showing CO2 and comfort readings, with parents and a child building wooden blocks on the sofa behind it"
      class="bg"
      widths={[768, 1280, 1600, 2400]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="veil" aria-hidden="true"></div>
    <div class="wrap">
      <span class="eyebrow"><span class="dot" aria-hidden="true"></span>{V.hero.eyebrow}</span>
      <h1>{V.hero.headline} <em>{V.hero.headlineEm}</em></h1>
      <div class="ctas">
        <a class="btn btn-solid" href="/contact/">{V.hero.primaryCta} →</a>
        <a class="btn btn-line" href="/products/">{V.hero.secondaryCta} →</a>
      </div>
    </div>
    <div class="hero-band">
      <div class="wrap">
        <div class="mq" aria-label="Sensing range">
          <div class="mq-t">
            {
              [0, 1].map((copy) => (
                <div class="set" aria-hidden={copy === 1 ? 'true' : undefined}>
                  {marquee.map((g) => <span class="chip">{g.label}</span>)}
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>

  {/* ② PRODUCTS — six cards, two rows of three */}
  <section class="prods">
    <div class="wrap">
      <div class="sec-head sec-head--row rv">
        <div>
          <span class="kicker">{V.products.kicker}</span>
          <h2>{V.products.heading}</h2>
        </div>
        <a class="alink" href="/products/">{V.products.allLabel} →</a>
      </div>
      {
        rows.map((row) => (
          <div class="prod-row">
            {row.map((f) => (
              <a class="pcard rv" href={f.href}>
                <div class="ph">
                  <Image src={f.image} alt={f.product.data.name} widths={[480, 720]} sizes="(min-width: 1000px) 380px, (min-width: 640px) 45vw, 94vw" loading="lazy" />
                </div>
                <div class="tx">
                  <span class="model">{f.product.data.model}</span>
                  <h3>{f.tagline}</h3>
                  <div class="chips">{f.chips.map((c) => <span>{c}</span>)}</div>
                </div>
              </a>
            ))}
          </div>
        ))
      }
    </div>
  </section>

  {/* ③ SOLUTIONS — accordion strip, hover to switch */}
  <section>
    <div class="wrap">
      <div class="sec-head rv">
        <span class="kicker">{V.solutions.kicker}</span>
        <h2>{V.solutions.heading}</h2>
      </div>
      <div class="sol-strip rv" data-sol>
        {
          scenes.map((s, i) => (
            <div class:list={['sol-p', { on: i === 0 }]} data-sol-p>
              <Image
                src={s.photo.src}
                alt={s.photo.alt}
                widths={[768, 1280, 1600]}
                sizes="(min-width: 1240px) 1140px, 94vw"
                loading={i === 0 ? 'eager' : 'lazy'}
                style={`--po:${s.focus.po};--pc:${s.focus.pc}`}
              />
              <div class="shade" aria-hidden="true"></div>
              <span class="tag">{s.label}</span>
              <div class="txt">
                <div>
                  <em>{s.label}</em>
                  <h3>{s.line}</h3>
                </div>
                <a href={`/solutions/${s.slug}/`}>{V.solutions.readMore} →</a>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ④ FACTORY — campus stage, five floor photos, stats, QC steps */}
  <section class="fac">
    <div class="wrap">
      <div class="sec-head rv">
        <span class="kicker">{V.factory.kicker}</span>
        <h2>{V.factory.heading}</h2>
      </div>
      <div class="stage rv">
        <Image src={ABOUT_HERO.photo.src} alt={ABOUT_HERO.photo.alt} widths={[768, 1280, 1600]} sizes="(min-width: 1240px) 1136px, 94vw" loading="lazy" />
        <div class="cap">
          <div class="t">
            <em>{V.factory.place}</em>
            <p>{V.factory.caption}</p>
          </div>
          <a class="btn btn-glass" href="/about/">{V.factory.aboutCta} →</a>
        </div>
      </div>
      <div class="floor rv">
        {
          floor.map((f) => (
            <figure>
              <Image src={f.src} alt={f.alt} widths={[320, 480]} sizes="(min-width: 1000px) 220px, 45vw" loading="lazy" />
              <figcaption>{f.caption}</figcaption>
            </figure>
          ))
        }
      </div>
      <div class="stats rv">
        {
          stats.map((s) => (
            <div>
              <b>{s.value}</b>
              <span>{s.label}</span>
            </div>
          ))
        }
      </div>
      <div class="qc rv">
        {
          V.factory.qc.map((q, i) => (
            <div>
              <em>{String(i + 1).padStart(2, '0')}</em>
              <h4>{q.title}</h4>
              <p>{q.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ⑤ WHY — four feature cards */}
  <section class="why">
    <div class="wrap">
      <div class="sec-head rv">
        <span class="kicker">{V.why.kicker}</span>
        <h2>{V.why.heading}</h2>
      </div>
      <div class="feat-row">
        {
          V.why.cards.map((c) => (
            <div class="feat rv">
              <div class="fhead">
                <span class="ico" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><path d={ICONS[c.icon] ?? ICONS.doc} /></svg>
                </span>
                <div class="fig">{c.fig}</div>
              </div>
              <h3>{c.title}</h3>
              <p>{c.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ⑥ PROGRAMME — dark band, three glass steps */}
  <section class="prog">
    <div class="wrap">
      <div class="sec-head rv">
        <span class="kicker">{V.programme.kicker}</span>
        <h2>{V.programme.heading}</h2>
      </div>
      <div class="steps">
        {
          V.programme.steps.map((s, i) => (
            <>
              {i > 0 && (
                <div class="arr" aria-hidden="true">
                  →
                </div>
              )}
              <div class="step rv">
                <div class="shead">
                  <span class="ico" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d={ICONS[s.icon] ?? ICONS.doc} /></svg>
                  </span>
                  <span class="d">{s.when}</span>
                </div>
                <h3>{s.title}</h3>
                <p>{s.body}</p>
              </div>
            </>
          ))
        }
      </div>
      <div class="foot rv">
        <a class="btn btn-solid" href="/contact/">{V.programme.cta} →</a>
        <span>{SITE.email} · {V.programme.noteSuffix}</span>
      </div>
    </div>
  </section>

  {/* ⑦ GUIDES — latest three */}
  <section>
    <div class="wrap">
      <div class="sec-head rv">
        <span class="kicker">{V.guides.kicker}</span>
        <h2>{V.guides.heading}</h2>
      </div>
      <div class="gd-grid">
        {
          guides.map((g) => (
            <a class="gd rv" href={`/guides/${g.slug}/`}>
              <em>{g.eyebrow}</em>
              <h3>{g.title}</h3>
              <p>{g.description}</p>
              <span>{V.guides.read} →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {/* ⑧ CTA */}
  <div class="wrap">
    <div class="cta-band rv">
      <div>
        <span class="kicker">{V.cta.kicker}</span>
        <h2>{V.cta.heading}</h2>
        <div class="ctas">
          <a class="btn btn-paper" href="/contact/">{V.cta.primary} →</a>
          <a class="btn btn-glass" href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </div>
      </div>
      <div class="send">
        <h4>{V.cta.sendTitle}</h4>
        <ul>
          {
            V.cta.items.map((item, i) => (
              <li>
                <b>{String(i + 1).padStart(2, '0')}</b> {item}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</HomeLayout>

<script>
  // scene accordion — Anker style: hover or click expands, one open at a time
  const panels = [...document.querySelectorAll<HTMLElement>('[data-sol-p]')];
  const solSwitch = (p: HTMLElement) => {
    if (p.classList.contains('on')) return;
    panels.forEach((x) => x.classList.toggle('on', x === p));
  };
  panels.forEach((p) => {
    p.addEventListener('click', () => solSwitch(p));
    p.addEventListener('mouseenter', () => solSwitch(p));
  });
</script>
