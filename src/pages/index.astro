    </ul>
  </div>

  {/* 2+3 ── products: curated eight, 2×4, All-products top-right; form-factor
      rail is an h3 subsection INSIDE this block (wanew: 先看货,机型是另一条路) */}
  <section class="as-section" id="featured">
    <div class="as-container">
      <div class="as-sechead as-sechead--row">
        <div>
          <p class="as-eyebrow">{PRODUCTS_HOME.eyebrow}</p>
          <h2 class="as-d2">{PRODUCTS_HOME.heading}</h2>
        </div>
        <a class="as-link-arrow" href="/products/">{PRODUCTS_HOME.allLink}</a>
      </div>
      <div class="as-pgrid as-pgrid--4">
        {
          curated.map((product) => (
            <a class="as-pcard" href={productHref(product)} data-as-reveal>
              <span class="as-stage">
                <Image
                  src={resolveProductImage(product.data.images.main)}
                  alt={product.data.name}
                  widths={[320, 480, 640]}
                  sizes="(min-width: 980px) 280px, (min-width: 560px) 45vw, 90vw"
