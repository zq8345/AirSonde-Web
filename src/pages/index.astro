      </div>
    </div>
  </section>

  {/* 4 ── scene tabs + one big panel (W8 spec, wanew "For every environment").
      wanew separates same-bg sections with hairlines; our light constitution
      (§3.2c) forbids hairlines — tonal alternation carries the separation. */}
