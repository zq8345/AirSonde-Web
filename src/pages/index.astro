---
import Base from '../layouts/Base.astro';
import { CAPABILITIES, CONTACT, HERO, SENSORS, SITE, VALUE_PROPS } from '../data/site';
---

<Base>
  {/* ---------- Hero ---------- */}
  <section class="relative overflow-hidden border-b border-white/10">
    <div
      class="pointer-events-none absolute -top-40 left-1/2 h-[38rem] w-[38rem] -translate-x-1/2 rounded-full bg-air-500/10 blur-3xl"
      aria-hidden="true"
    >
    </div>

    <div class="relative mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
      <p
        class="inline-flex items-center rounded-full border border-air-400/30 bg-air-500/10 px-3.5 py-1.5 text-xs font-medium uppercase tracking-wider text-air-300"
      >
        {HERO.eyebrow}
      </p>

      <h1
        class="mt-6 max-w-3xl text-4xl font-bold leading-[1.1] tracking-tight text-ink-50 sm:text-5xl lg:text-6xl"
      >
        <span class="text-air-400">{SITE.brand}</span> — {HERO.headline}
      </h1>

      <p class="mt-5 max-w-2xl text-base font-medium text-air-300 sm:text-lg">
        {HERO.tagline}
      </p>

      <p class="mt-5 max-w-2xl text-base leading-relaxed text-ink-300 sm:text-lg">
        {HERO.body}
      </p>

      <div class="mt-9 flex flex-wrap gap-3">
        <a
          href={HERO.primaryCta.href}
          class="rounded-lg bg-air-500 px-6 py-3 text-sm font-semibold text-ink-950 transition-colors hover:bg-air-400"
        >
          {HERO.primaryCta.label}
        </a>
        <a
          href={HERO.secondaryCta.href}
          class="rounded-lg border border-white/15 px-6 py-3 text-sm font-semibold text-ink-100 transition-colors hover:border-white/30 hover:bg-white/5"
        >
          {HERO.secondaryCta.label}
        </a>
      </div>

      <ul class="mt-12 flex flex-wrap gap-2.5">
        {
          SENSORS.map((sensor) => (
            <li class="rounded-lg border border-white/10 bg-white/[0.03] px-3.5 py-2">
              <span class="text-sm font-semibold text-ink-100">{sensor.code}</span>
              <span class="ml-2 text-xs text-ink-400">{sensor.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* ---------- What we do ---------- */}
  <section id="what-we-do" class="border-b border-white/10 scroll-mt-20">
    <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8">
      <h2 class="text-2xl font-bold tracking-tight text-ink-50 sm:text-3xl">
        A manufacturing partner, not a brand you compete with
      </h2>

      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {
          VALUE_PROPS.map((prop) => (
            <article class="rounded-xl border border-white/10 bg-white/[0.02] p-6">
              <h3 class="text-lg font-semibold text-ink-50">{prop.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-ink-300">{prop.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* ---------- Capabilities ---------- */}
  <section id="capabilities" class="border-b border-white/10 scroll-mt-20">
    <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8">
      <h2 class="text-2xl font-bold tracking-tight text-ink-50 sm:text-3xl">
        What we can build for you
      </h2>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-ink-400">
        Every unit is specified with you before tooling. The list below is where most programmes
        start.
      </p>

      <dl class="mt-10 grid gap-x-10 gap-y-8 sm:grid-cols-2">
        {
          CAPABILITIES.map((item) => (
            <div class="border-l-2 border-air-500/40 pl-5">
              <dt class="text-base font-semibold text-ink-50">{item.title}</dt>
              <dd class="mt-2 text-sm leading-relaxed text-ink-300">{item.body}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  {/* ---------- Contact ---------- */}
  <section id="contact" class="scroll-mt-20">
    <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8">
      <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-8 sm:p-12">
        <h2 class="max-w-2xl text-2xl font-bold tracking-tight text-ink-50 sm:text-3xl">
          {CONTACT.title}
        </h2>
        <p class="mt-4 max-w-2xl text-sm leading-relaxed text-ink-300 sm:text-base">
          {CONTACT.body}
        </p>
        <a
          href={`mailto:${SITE.email}`}
          class="mt-8 inline-flex rounded-lg bg-air-500 px-6 py-3 text-sm font-semibold text-ink-950 transition-colors hover:bg-air-400"
        >
          {SITE.email}
        </a>
      </div>
    </div>
  </section>
</Base>
