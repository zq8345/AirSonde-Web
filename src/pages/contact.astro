---
/**
 * /contact/ — W4 page 3, light theme. Channels mirror wanew.com/contact
 * (same number for WhatsApp / WeChat / phone, per Joe). The enquiry form is
 * deliberately absent: Web3Forms needs Joe's own access key (⛔ reusing the
 * wanew key would route enquiries to the wrong inbox). sales@ is the primary
 * conversion piece until then.
 */
import { Image } from 'astro:assets';
import LightBase from '../layouts/LightBase.astro';
import { CONTACT, CONTACT_CHANNELS, CONTACT_PAGE, META, SITE } from '../data/site';
import { breadcrumbSchema } from '../lib/jsonld';
import wechatQr from '../assets/photos/wechat-qr.webp';

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: `${SITE.url}/` },
    { name: 'Contact', url: `${SITE.url}/contact/` },
  ]),
];
---

<LightBase title={META.contact.title} description={META.contact.description} schemas={schemas}>
  <section class="as-section" style="padding-bottom:48px">
    <div class="as-container as-pagehead">
      <p class="as-eyebrow">{CONTACT_PAGE.eyebrow}</p>
      <h1 class="as-pagehead__title">{CONTACT.title}</h1>
      <p class="as-pagehead__lead">{CONTACT.body}</p>
      <div class="as-pagehead__actions">
        <a href={`mailto:${SITE.email}`} class="as-btn as-btn--primary">
          {SITE.email}
          <span class="as-arw" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="as-section as-band--alt">
    <div class="as-container">
      <div class="as-contact-grid">
        <div>
          <div class="as-sechead">
            <h2 class="as-h2">{CONTACT_PAGE.askHeading}</h2>
            <p class="as-sub">{CONTACT_PAGE.askIntro}</p>
          </div>
          <ul class="as-checklist">
            {CONTACT_PAGE.ask.map((line) => <li>{line}</li>)}
          </ul>
        </div>

        <div>
          <div class="as-sechead">
            <h2 class="as-h2">{CONTACT_CHANNELS.heading}</h2>
          </div>
          <div class="as-channels">
            <div class="as-channel">
              <span class="as-channel__label">{CONTACT_CHANNELS.email.label}</span>
              <a class="as-channel__value" href={CONTACT_CHANNELS.email.href}>
                {CONTACT_CHANNELS.email.value}
              </a>
            </div>
            <div class="as-channel">
              <span class="as-channel__label">{CONTACT_CHANNELS.whatsapp.label}</span>
              <a class="as-channel__value" href={CONTACT_CHANNELS.whatsapp.href} rel="noopener">
                {CONTACT_CHANNELS.whatsapp.value}
              </a>
            </div>
            <div class="as-channel" data-wechat>
              <span class="as-channel__label">{CONTACT_CHANNELS.wechat.label}</span>
              <button
                type="button"
                class="as-channel__value as-channel__btn as-wechat-btn"
                aria-expanded="false"
              >
                {CONTACT_CHANNELS.wechat.id}
              </button>
              <div class="as-wechat-pop">
                <Image src={wechatQr} alt={CONTACT_CHANNELS.wechat.scanHint} widths={[180, 360]} sizes="180px" loading="lazy" />
                <p class="as-wechat-pop__scan">{CONTACT_CHANNELS.wechat.scanHint}</p>
                <button
                  type="button"
                  class="as-wechat-pop__copy"
                  data-wechat-copy
                  data-id={CONTACT_CHANNELS.wechat.id}
                >
                  {CONTACT_CHANNELS.wechat.copyLabel}
                </button>
              </div>
            </div>
            <div class="as-channel">
              <span class="as-channel__label">{CONTACT_CHANNELS.phone.label}</span>
              <a class="as-channel__value" href={CONTACT_CHANNELS.phone.href}>
                {CONTACT_CHANNELS.phone.value}
              </a>
            </div>
          </div>
          <p class="as-sub" style="font-size:var(--as-fs-compact);margin-top:16px">
            {CONTACT_PAGE.asideBody}
          </p>
          <a
            href="/products"
            class="as-link-arrow"
            style="margin-top:10px">{CONTACT_PAGE.asideLink}</a
          >
        </div>
      </div>
    </div>
  </section>
</LightBase>

<script>
  // Forked from wanew skin/js/w3.js @747d4e95d (WeChat QR popover + copy id) —
  // same behaviour: toggle, outside-click / Escape close, clipboard fallback.
  document.querySelectorAll<HTMLElement>('[data-wechat]').forEach((wrap) => {
    const btn = wrap.querySelector<HTMLButtonElement>('.as-wechat-btn');
    const pop = wrap.querySelector<HTMLElement>('.as-wechat-pop');
    if (!btn || !pop) return;
    const close = () => {
      pop.classList.remove('is-open');
      btn.setAttribute('aria-expanded', 'false');
    };
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = pop.classList.toggle('is-open');
      btn.setAttribute('aria-expanded', String(open));
    });
    document.addEventListener('click', (e) => {
      if (!wrap.contains(e.target as Node)) close();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });
    const copyBtn = pop.querySelector<HTMLButtonElement>('[data-wechat-copy]');
    copyBtn?.addEventListener('click', () => {
      const id = copyBtn.getAttribute('data-id') || '';
      const done = () => {
        copyBtn.classList.add('is-copied');
        copyBtn.textContent = 'Copied';
        setTimeout(() => {
          copyBtn.classList.remove('is-copied');
          copyBtn.textContent = 'Copy WeChat ID';
        }, 1600);
      };
      navigator.clipboard?.writeText(id).then(done, done);
    });
  });
</script>
