---
/**
 * /contact/ v1 — Design System v1 (真源 airsonde-design/contact-v1.html, DESIGN.md wins on
 * conflict). Skin only: the form's field NAMES, the honeypot, the inquiry allowlist and
 * the submit/status logic are unchanged from W7/W10-B — /api/contact and the CRM copy
 * see exactly the same wire shape. "WhatsApp" is the new display label of `phone`.
 * The crawlable surface is unchanged: same title, description, canonical, BreadcrumbList.
 *
 * 🔁 Replaceable asset slot: the WeChat QR is `src/assets/photos/wechat-qr.webp`
 * (imported below). The Admin upload single (admin-wechat-qr-upload) replaces that file;
 * nothing else on this page references it.
 */
import { Image } from 'astro:assets';
import HomeLayout from '../layouts/HomeLayout.astro';
import '../styles/contact-v1.css';
import { CONTACT_CHANNELS, CONTACT_FORM, CONTACT_INFO, CONTACT_V1, META, SITE } from '../data/site';
import { breadcrumbSchema } from '../lib/jsonld';
import wechatQr from '../assets/photos/wechat-qr.webp';
import heroPhoto from '../assets/photos/contact-support-hero.webp';

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: `${SITE.url}/` },
    { name: 'Contact', url: `${SITE.url}/contact/` },
  ]),
];

const V = CONTACT_V1;
const F = V.fields;
const L = V.info.labels;
---

<HomeLayout title={META.contact.title} description={META.contact.description} schemas={schemas}>
  <div class="phero">
    <Image
      src={heroPhoto}
      alt="Reception area with staff at their desks and the airsonde wordmark on the wall"
      class="bg"
      style="object-position: center 35%"
      widths={[768, 1280, 1600, 2400]}
      sizes="100vw"
      quality={72}
      loading="eager"
      fetchpriority="high"
    />
    <div class="veil" aria-hidden="true"></div>
    <div class="wrap">
      <span class="kicker">{V.hero.kicker}</span>
      <h1>{V.hero.heading}</h1>
    </div>
  </div>

  <section class="csec">
    <div class="wrap">
      <div class="cgrid">
        <form class="fcard" id="contact-form" method="post" action="/api/contact" novalidate={false}>
          <div class="fgrid">
            <label class="field">
              <span>{F.company} <i aria-hidden="true">*</i></span>
              <input type="text" name="company" required maxlength="200" autocomplete="organization" />
            </label>
            <label class="field">
              <span>{F.name} <i aria-hidden="true">*</i></span>
              <input type="text" name="name" required maxlength="200" autocomplete="name" />
            </label>
            <label class="field">
              <span>{F.email} <i aria-hidden="true">*</i></span>
              <input type="email" name="email" required maxlength="254" autocomplete="email" />
            </label>
            <label class="field">
              <span>{F.whatsapp}</span>
              <input type="tel" name="phone" maxlength="50" autocomplete="tel" />
            </label>
            <label class="field wide">
              <span>{F.inquiryType}</span>
              <select name="inquiry_type">
                {CONTACT_FORM.inquiryOptions.map((opt) => <option value={opt}>{opt}</option>)}
              </select>
            </label>
            <label class="field wide">
              <span>{F.message} <i aria-hidden="true">*</i></span>
              <textarea name="message" required maxlength="3000"></textarea>
            </label>
          </div>
          <label class="hp" aria-hidden="true">
            Website
            <input type="text" name="website" tabindex="-1" autocomplete="off" />
          </label>
          <div class="ffoot">
            <button type="submit" class="btn btn-solid">{V.submit} →</button>
            <p>{V.replyNote}</p>
            <p class="fstatus" data-status="idle" aria-live="polite">
              <span data-when="sent">{CONTACT_FORM.sent}</span>
              <span data-when="failed">
                {CONTACT_FORM.failed}{' '}<a href={`mailto:${SITE.email}`}>{SITE.email}</a>
              </span>
            </p>
          </div>
        </form>

        <div class="side">
          <div class="info">
            <h3>{V.info.title}</h3>
            <ul>
              <li>
                <em>{L.email}</em>
                <div><a class="mail" href={`mailto:${SITE.email}`}>{SITE.email}</a></div>
              </li>
              <li>
                <em>{L.whatsapp}</em>
                <div>
                  <a class="mail" href={CONTACT_CHANNELS.whatsapp.href} target="_blank" rel="noopener">
                    {CONTACT_CHANNELS.whatsapp.value}
                  </a>
                </div>
              </li>
              <li class="wx" tabindex="0" aria-describedby="wxpop">
                <em>{L.wechat}</em>
                <div>{CONTACT_CHANNELS.phone.value}</div>
                <div class="wxpop" id="wxpop" role="tooltip">
                  {/* 🔁 replaceable asset: src/assets/photos/wechat-qr.webp */}
                  <Image src={wechatQr} alt={V.info.wechatScan} widths={[184, 368]} sizes="184px" loading="lazy" />
                  <p>{V.info.wechatScan}</p>
                </div>
              </li>
              <li>
                <em>{L.address}</em>
                <div>{CONTACT_INFO.address}</div>
              </li>
              <li>
                <em>{L.hours}</em>
                <div>{CONTACT_INFO.hours}</div>
              </li>
            </ul>
            <div class="map">
              <iframe src={V.mapEmbed} loading="lazy" referrerpolicy="no-referrer-when-downgrade" title={V.info.mapTitle}></iframe>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</HomeLayout>

<script>
  // W7 enquiry form, unchanged: native constraint validation gates the submit event;
  // anything short of {ok:true} from /api/contact shows the failed line — the Function is
  // fail-closed and this mirrors it.
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = form?.querySelector<HTMLElement>('[data-status]');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (btn) btn.disabled = true;
    status?.setAttribute('data-status', 'idle');
    let ok = false;
    try {
      const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
      const data = (await res.json().catch(() => null)) as { ok?: boolean } | null;
      ok = res.ok && data?.ok === true;
    } catch {
      ok = false;
    }
    status?.setAttribute('data-status', ok ? 'sent' : 'failed');
    if (ok) form.reset();
    if (btn) btn.disabled = false;
  });
</script>
