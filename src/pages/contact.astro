---
/**
 * /contact/ — W4 page 3, light theme. Channels mirror wanew.com/contact
 * (same number for WhatsApp / WeChat / phone, per Joe). The enquiry form
 * (W7) posts to /api/contact — a Pages Function that pushes to Joe's Lark
 * group. Not Web3Forms: that needed Joe's own key, and Lark is where he
 * actually reads. Delivery errors always surface the mailto fallback.
 */
import { Image } from 'astro:assets';
import LightBase from '../layouts/LightBase.astro';
import { CONTACT, CONTACT_CHANNELS, CONTACT_FORM, CONTACT_PAGE, META, SITE } from '../data/site';
import { breadcrumbSchema } from '../lib/jsonld';
import wechatQr from '../assets/photos/wechat-qr.webp';

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: `${SITE.url}/` },
    { name: 'Contact', url: `${SITE.url}/contact/` },
  ]),
];
---

<LightBase title={META.contact.title} description={META.contact.description} schemas={schemas}>
  <section class="as-section" style="padding-bottom:48px">
    <div class="as-container as-pagehead">
      <p class="as-eyebrow">{CONTACT_PAGE.eyebrow}</p>
      <h1 class="as-pagehead__title">{CONTACT.title}</h1>
      <p class="as-pagehead__lead">{CONTACT.body}</p>
      <div class="as-pagehead__actions">
        <a href={`mailto:${SITE.email}`} class="as-btn as-btn--primary">
          {SITE.email}
          <span class="as-arw" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  {/* W7 enquiry form — same fields the Function validates; browser-native
      required/maxlength mirror the server rules, they don't replace them */}
  <section class="as-section" style="padding-top:0">
    <div class="as-container">
      <form class="as-fform" id="contact-form" method="post" action="/api/contact">
        <h2 class="as-h2">{CONTACT_FORM.heading}</h2>
        <div class="as-fform__grid">
          <label class="as-field">
            <span class="as-field__label">{CONTACT_FORM.fields.name}</span>
            <input class="as-field__input" type="text" name="name" required maxlength="200" autocomplete="name" />
          </label>
          <label class="as-field">
            <span class="as-field__label">{CONTACT_FORM.fields.company}</span>
            <input class="as-field__input" type="text" name="company" required maxlength="200" autocomplete="organization" />
          </label>
          <label class="as-field as-field--wide">
            <span class="as-field__label">{CONTACT_FORM.fields.email}</span>
            <input class="as-field__input" type="email" name="email" required maxlength="254" autocomplete="email" />
          </label>
          <label class="as-field as-field--wide">
            <span class="as-field__label">{CONTACT_FORM.fields.message}</span>
            <textarea class="as-field__input" name="message" required maxlength="3000" rows="6"></textarea>
          </label>
        </div>
        <label class="as-fform__hp" aria-hidden="true">
          Website
          <input type="text" name="website" tabindex="-1" autocomplete="off" />
        </label>
        <div class="as-fform__foot">
          <button type="submit" class="as-btn as-btn--primary">{CONTACT_FORM.submit}</button>
          <p class="as-fform__status" data-status="idle" aria-live="polite">
            <span data-when="sent">{CONTACT_FORM.sent}</span>
            <span data-when="failed">
              {CONTACT_FORM.failed}{' '}<a href={`mailto:${SITE.email}`}>{SITE.email}</a>
            </span>
          </p>
        </div>
      </form>
    </div>
  </section>

  <section class="as-section as-band--alt">
    <div class="as-container">
      <div class="as-contact-grid">
        <div>
          <div class="as-sechead">
            <h2 class="as-h2">{CONTACT_PAGE.askHeading}</h2>
            <p class="as-sub">{CONTACT_PAGE.askIntro}</p>
          </div>
          <ul class="as-checklist">
            {CONTACT_PAGE.ask.map((line) => <li>{line}</li>)}
          </ul>
        </div>

        <div>
          <div class="as-sechead">
            <h2 class="as-h2">{CONTACT_CHANNELS.heading}</h2>
          </div>
          <div class="as-channels">
            <div class="as-channel">
              <span class="as-channel__label">{CONTACT_CHANNELS.email.label}</span>
              <a class="as-channel__value" href={CONTACT_CHANNELS.email.href}>
                {CONTACT_CHANNELS.email.value}
              </a>
            </div>
            <div class="as-channel">
              <span class="as-channel__label">{CONTACT_CHANNELS.whatsapp.label}</span>
              <a class="as-channel__value" href={CONTACT_CHANNELS.whatsapp.href} rel="noopener">
                {CONTACT_CHANNELS.whatsapp.value}
              </a>
            </div>
            <div class="as-channel" data-wechat>
              <span class="as-channel__label">{CONTACT_CHANNELS.wechat.label}</span>
              <button
                type="button"
                class="as-channel__value as-channel__btn as-wechat-btn"
                aria-expanded="false"
              >
                {CONTACT_CHANNELS.wechat.id}
              </button>
              <div class="as-wechat-pop">
                <Image src={wechatQr} alt={CONTACT_CHANNELS.wechat.scanHint} widths={[180, 360]} sizes="180px" loading="lazy" />
                <p class="as-wechat-pop__scan">{CONTACT_CHANNELS.wechat.scanHint}</p>
                <button
                  type="button"
                  class="as-wechat-pop__copy"
                  data-wechat-copy
                  data-id={CONTACT_CHANNELS.wechat.id}
                >
                  {CONTACT_CHANNELS.wechat.copyLabel}
                </button>
              </div>
            </div>
            <div class="as-channel">
              <span class="as-channel__label">{CONTACT_CHANNELS.phone.label}</span>
              <a class="as-channel__value" href={CONTACT_CHANNELS.phone.href}>
                {CONTACT_CHANNELS.phone.value}
              </a>
            </div>
          </div>
          <p class="as-sub" style="font-size:var(--as-fs-compact);margin-top:16px">
            {CONTACT_PAGE.asideBody}
          </p>
          <a
            href="/products"
            class="as-link-arrow"
            style="margin-top:10px">{CONTACT_PAGE.asideLink}</a
          >
        </div>
      </div>
    </div>
  </section>
</LightBase>

<script>
  // W7 enquiry form. Native constraint validation gates the submit event;
  // anything short of {ok:true} from /api/contact shows the failed line —
  // the Function is fail-closed and this mirrors it.
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = form?.querySelector<HTMLElement>('[data-status]');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (btn) btn.disabled = true;
    status?.setAttribute('data-status', 'idle');
    let ok = false;
    try {
      const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
      const data = (await res.json().catch(() => null)) as { ok?: boolean } | null;
      ok = res.ok && data?.ok === true;
    } catch {
      ok = false;
    }
    status?.setAttribute('data-status', ok ? 'sent' : 'failed');
    if (ok) form.reset();
    if (btn) btn.disabled = false;
  });

  // Forked from wanew skin/js/w3.js @747d4e95d (WeChat QR popover + copy id) —
  // same behaviour: toggle, outside-click / Escape close, clipboard fallback.
  document.querySelectorAll<HTMLElement>('[data-wechat]').forEach((wrap) => {
    const btn = wrap.querySelector<HTMLButtonElement>('.as-wechat-btn');
    const pop = wrap.querySelector<HTMLElement>('.as-wechat-pop');
    if (!btn || !pop) return;
    const close = () => {
      pop.classList.remove('is-open');
      btn.setAttribute('aria-expanded', 'false');
    };
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = pop.classList.toggle('is-open');
      btn.setAttribute('aria-expanded', String(open));
    });
    document.addEventListener('click', (e) => {
      if (!wrap.contains(e.target as Node)) close();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });
    const copyBtn = pop.querySelector<HTMLButtonElement>('[data-wechat-copy]');
    copyBtn?.addEventListener('click', () => {
      const id = copyBtn.getAttribute('data-id') || '';
      const done = () => {
        copyBtn.classList.add('is-copied');
        copyBtn.textContent = 'Copied';
        setTimeout(() => {
          copyBtn.classList.remove('is-copied');
          copyBtn.textContent = 'Copy WeChat ID';
        }, 1600);
      };
      navigator.clipboard?.writeText(id).then(done, done);
    });
  });
</script>
