---
/**
 * /about/ — W10: rebuilt on wanew.com/about's nine-section skeleton
 * (page-header / story+media+where / capability tiles+stats / quality /
 * OEM-ODM / FAQ / CTA). Light theme stays; every sentence renders from
 * src/data/about.ts. 🔴 wanew's COMPLIANCE & TESTING cert strip is NOT
 * ported — our own verified compliance-engineering block (company-level
 * routes + per-model qualifier) stays instead.
 */
import { Image } from 'astro:assets';
import LightBase from '../layouts/LightBase.astro';
import { SITE } from '../data/site';
import {
  ABOUT_COMPLIANCE,
  ABOUT_CTA,
  ABOUT_FACTORY,
  ABOUT_FAQ,
  ABOUT_HERO,
  ABOUT_META,
  ABOUT_QUALITY,
  ABOUT_SERVICES,
  ABOUT_STATS,
  ABOUT_STORY,
  ABOUT_WHERE,
} from '../data/about';
// ABOUT_WHERE.photo is no longer rendered here (Joe) — the asset stays in the
// data file so the where-line and the photo can be restored together.
import { breadcrumbSchema } from '../lib/jsonld';

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: `${SITE.url}/` },
    { name: 'About', url: `${SITE.url}/about/` },
  ]),
];
---

<LightBase title={ABOUT_META.title} description={ABOUT_META.description} schemas={schemas}>
  {/* 1 ── photo hero (§3.2d info-page hero) */}
  <section class="as-hero as-hero--page" style={`--hero-focus: ${ABOUT_HERO.photo.focus}`}>
    <Image
      src={ABOUT_HERO.photo.src}
      alt={ABOUT_HERO.photo.alt}
      class="as-hero__img"
      widths={[768, 1280, 1600, 2400]}
      sizes="100vw"
      quality={68}
      loading="eager"
      fetchpriority="high"
    />
    <div class="as-hero__wash" aria-hidden="true"></div>
    <div class="as-container as-hero__in">
      <p class="as-hero__eyebrow">{ABOUT_HERO.eyebrow}</p>
      <h1 class="as-hero__title">{ABOUT_HERO.heading}</h1>
      <p class="as-hero__lead">{ABOUT_HERO.lead}</p>
    </div>
  </section>

  {/* 2+3 ── story: kicker + statement | body, closed by the where-line row */}
  <section class="as-section as-abstory-section">
    <div class="as-container">
      <div class="as-abstory">
        <div>
          <p class="as-eyebrow">{ABOUT_STORY.kicker}</p>
          <h2 class="as-d2">{ABOUT_STORY.heading}</h2>
        </div>
        <div class="as-abstory__body">
          {ABOUT_STORY.paragraphs.map((p) => <p>{p}</p>)}
        </div>
      </div>
      {/* Joe: the office photo came off — the same floor is already shown in
          the capability tiles below. The where-line stays. */}
      <p class="as-abwhere">
        {ABOUT_WHERE.label}
        <b>{ABOUT_WHERE.place}</b>
      </p>
    </div>
  </section>

  {/* 4+5 ── manufacturing capability: six labelled tiles + the six figures */}
  <section class="as-section as-band--alt">
    <div class="as-container">
      <div class="as-sechead">
        <h2 class="as-d2">{ABOUT_FACTORY.heading}</h2>
        <p class="as-sub">{ABOUT_FACTORY.intro}</p>
      </div>
      <div class="as-factory">
        {
          ABOUT_FACTORY.photos.map((photo) => (
            <figure data-as-reveal>
              <Image src={photo.src} alt={photo.alt} widths={[480, 760]} sizes="(min-width: 900px) 30vw, (min-width: 560px) 45vw, 94vw" loading="lazy" />
              <figcaption>{photo.caption}</figcaption>
            </figure>
          ))
        }
      </div>
      <div class="as-stats" style="margin-top:44px">
        {
          ABOUT_STATS.items.map((s) => (
            <div class="as-stat">
              <div class="as-stat__value">{s.value}</div>
              <div class="as-stat__label">{s.label}</div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* 6 ── quality process. 🔴 wanew's cert strip is not ported; our verified
      compliance-engineering block (with the per-model qualifier) stays. */}
  <section class="as-section">
    <div class="as-container">
      <div class="as-sechead">
        <h2 class="as-d2">{ABOUT_QUALITY.heading}</h2>
        <p class="as-sub">{ABOUT_QUALITY.intro}</p>
      </div>
      <div class="as-steps">
        {
          ABOUT_QUALITY.steps.map((step, i) => (
            <div class="as-step">
              <div class="as-step__n">{String(i + 1).padStart(2, '0')}</div>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </div>
          ))
        }
      </div>

      {/* 🔴 no cert names, no badges — 总工裁定 2026-08-12: scoped-per-programme
          wording only, until real per-model documents exist */}
      <div style="margin-top:44px">
        <h3 style="font-size:var(--as-fs-h3);font-weight:700;color:var(--as-ink)">
          {ABOUT_COMPLIANCE.heading}
        </h3>
        <p class="as-sub">{ABOUT_COMPLIANCE.body}</p>
      </div>
    </div>
  </section>

  {/* 7 ── OEM / ODM services (wanew ab8-oem two-card grid) */}
  <section class="as-section as-band--alt">
    <div class="as-container">
      <div class="as-sechead">
        <h2 class="as-d2">{ABOUT_SERVICES.heading}</h2>
      </div>
      <div class="as-cards2">
        {
          ABOUT_SERVICES.cards.map((card) => (
            <article class="as-panelcard">
              <h3>{card.title}</h3>
              <p>{card.body}</p>
              <ul class="as-panelcard__points">
                {card.points.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* 8 ── FAQ — three honest answers, existing sentences */}
  <section class="as-section">
    <div class="as-container">
      <div class="as-sechead">
        <p class="as-eyebrow">{ABOUT_FAQ.kicker}</p>
        <h2 class="as-d2">{ABOUT_FAQ.heading}</h2>
      </div>
      <ul class="as-faq">
        {
          ABOUT_FAQ.items.map((item) => (
            <li>
              <h3>{item.q}</h3>
              <p>{item.a}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* 9 ── CTA */}
  <section class="as-section" style="padding-top:0">
    <div class="as-container">
      <div class="as-cta">
        <h2 class="as-cta__title">{ABOUT_CTA.heading}</h2>
        <p class="as-cta__body">{ABOUT_CTA.body}</p>
        <div class="as-cta__actions">
          <a href="/contact/" class="as-btn as-btn--primary">
            Request a quote
            <span class="as-arw" aria-hidden="true">→</span>
          </a>
          <a href="/products/" class="as-btn as-btn--ghost">All products</a>
        </div>
      </div>
    </div>
  </section>
</LightBase>
