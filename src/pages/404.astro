---
/**
 * 404 — light skin (W4 收尾, 总工裁定并入). Served at arbitrary URLs, so it
 * keeps noindex and no canonical; its body must stay distinct from the
 * homepage (the soft-404 gate lives on that difference).
 */
import LightBase from '../layouts/LightBase.astro';
import { META, NAV, NOT_FOUND_PAGE } from '../data/site';
---

<LightBase title={META.notFound.title} description={META.notFound.description} noindex>
  <section class="as-section">
    <div class="as-container as-pagehead" style="padding-top:96px;padding-bottom:40px">
      <p class="as-eyebrow">{NOT_FOUND_PAGE.eyebrow}</p>
      <h1 class="as-pagehead__title">{NOT_FOUND_PAGE.heading}</h1>
      <p class="as-pagehead__lead">{NOT_FOUND_PAGE.body}</p>
      <div class="as-pagehead__actions">
        <a href="/" class="as-btn as-btn--primary">
          {NOT_FOUND_PAGE.cta}
          <span class="as-arw" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="as-section" style="padding-top:0">
    <div class="as-container">
      <nav aria-label="Suggested pages">
        <h2 class="as-pdp__h" style="margin-top:0">{NOT_FOUND_PAGE.suggestionsHeading}</h2>
        <ul class="as-pdp__list" style="margin-top:14px">
          {
            NAV.map((item) => (
              <li>
                <a href={item.href} class="as-link-arrow">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </section>
</LightBase>
