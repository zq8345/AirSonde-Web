---
/**
 * /solutions/<scene>/ — one template for the four scenes (真源 airsonde-design/solution-home-v1.html,
 * the Home sample; DESIGN.md wins on conflict). Joe's bar for these pages: copy correct, layout
 * tidy, no overflow, no broken images — no pixel-level comparison.
 *
 * hero (scene photo, §4 veil) → three pain cards (old page copy, verbatim, from solutions.ts) →
 * fitting platforms (the scene's curated slugs, real catalogue data, short taglines from the
 * design files) → related guides (guides declare their scenes) → slim CTA → footer.
 * The crawlable surface is unchanged: same title, description, canonical, BreadcrumbList.
 */
import { Image } from 'astro:assets';
import type { GetStaticPaths } from 'astro';
import HomeLayout from '../../layouts/HomeLayout.astro';
import '../../styles/solution-v1.css';
import { HOME_V4, SITE, SOLUTIONS_V3, SOLUTION_DETAILS } from '../../data/site';
import { SCENES_DATA } from '../../data/solutions';
import { GUIDES } from '../../data/guides';
import { breadcrumbSchema } from '../../lib/jsonld';
import { getPublishedProducts, headlineSensors, productHref, resolveProductImage } from '../../lib/products';
import { chipLabel } from '../../lib/catalog-filters';

export const getStaticPaths = (async () => {
  return SCENES_DATA.map((scene) => ({ params: { scene: scene.slug }, props: { scene } }));
}) satisfies GetStaticPaths;

const { scene } = Astro.props;
const D = SOLUTION_DETAILS;
const C = HOME_V4.cta;

// H1 = the index page's card heading for this scene, so the two pages say the same thing
const indexCard = SOLUTIONS_V3.scenes.find((s) => s.slug === scene.slug);
const heading = indexCard?.heading ?? scene.heading;

// hero crop: the index card's framing for this scene (same photo, same subject)
const HERO_FOCUS: Record<string, string> = { home: '62% 50%', office: '72% 60%', school: '74% 50%', industrial: '70% 42%' };
// dark photos get the lighter left band (DESIGN.md §4); the office scene is the dark one
const DARK_SCENES = new Set(['office']);

const products = await getPublishedProducts();
const bySlug = new Map(products.map((p) => [p.data.slug, p]));
/**
 * ⚠️ A curated slug that matches no published product is skipped and named on stderr, not a
 * build failure — measured 2026-08-28: one dangling slug took the site down for nine hours.
 */
const missingFits = scene.productSlugs.filter((slug) => !bySlug.has(slug));
if (missingFits.length > 0) {
  console.warn(
    `[solutions/${scene.slug}] ${missingFits.length} curated product slug(s) match no published product and are skipped: ${missingFits.join(', ')}`,
  );
}
const fits = scene.productSlugs
  .map((slug) => bySlug.get(slug))
  .filter((p) => p !== undefined)
  .map((p) => ({
    product: p,
    // short tagline from the design files (solution-home-v1 / products-v1); the catalogue name is the fallback
    tagline: (D.taglines as Record<string, string>)[p.data.model] ?? p.data.name,
    chips: headlineSensors(p, 3).map(chipLabel),
  }));

const relatedGuides = GUIDES.filter((g) => g.solutionSlugs.includes(scene.slug));
const painsHeading = (D.painsHeading as Record<string, string>)[scene.slug] ?? D.painsHeading.home;

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: `${SITE.url}/` },
    { name: 'Solutions', url: `${SITE.url}/solutions/` },
    { name: scene.label, url: `${SITE.url}/solutions/${scene.slug}/` },
  ]),
];
---

<HomeLayout title={scene.meta.title} description={scene.meta.description} schemas={schemas}>
  <div class="sdet">
    <div class:list={['phero', { 'phero--dark': DARK_SCENES.has(scene.slug) }]}>
      <Image
        src={scene.photo.src}
        alt={scene.photo.alt}
        class="bg"
        style={`object-position: ${HERO_FOCUS[scene.slug] ?? '50% 50%'}`}
        widths={[768, 1280, 1600, 2400]}
        sizes="100vw"
        quality={72}
        loading="eager"
        fetchpriority="high"
      />
      <div class="veil" aria-hidden="true"></div>
      <div class="wrap">
        <span class="kicker">{D.kickerPrefix} · {scene.label}</span>
        <h1>{heading}</h1>
      </div>
    </div>

    <section class="sec-first">
      <div class="wrap">
        <div class="sec-head">
          <div>
            <span class="kicker">{D.whyKicker}</span>
            <h2>{painsHeading}</h2>
          </div>
        </div>
        <div class="pains">
          {
            scene.pains.map((pain, i) => (
              <div class="pain">
                <em>{String(i + 1).padStart(2, '0')}</em>
                <h3>{pain.title}</h3>
                <p>{pain.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="alt">
      <div class="wrap">
        <div class="sec-head">
          <div>
            <span class="kicker">{D.platformsKicker}</span>
            <h2>{scene.productsHeading}</h2>
          </div>
          <a class="alink" href="/products/">{HOME_V4.products.allLabel} →</a>
        </div>
        <div class="prod-row">
          {
            fits.map(({ product, tagline, chips }) => (
              <a class="pcard" href={productHref(product)}>
                <div class="ph">
                  <Image
                    src={resolveProductImage(product.data.images.main)}
                    alt={product.data.name}
                    widths={[320, 480, 640]}
                    sizes="(min-width: 1000px) 363px, (min-width: 640px) 45vw, 90vw"
                    loading="lazy"
                  />
                </div>
                <div class="tx">
                  <span class="model">{product.data.model}</span>
                  <h3>{tagline}</h3>
                  <div class="chips">{chips.map((c) => <span>{c}</span>)}</div>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    {
      relatedGuides.length > 0 && (
        <section>
          <div class="wrap">
            <div class="sec-head">
              <div>
                <span class="kicker">{D.guidesKicker}</span>
                <h2>{D.guidesHeading}</h2>
              </div>
            </div>
            <div class="gd-grid">
              {relatedGuides.map((g) => (
                <a class="gd" href={`/guides/${g.slug}/`}>
                  <em>{g.eyebrow}</em>
                  <h3>{g.title}</h3>
                  <span>{HOME_V4.guides.read} →</span>
                </a>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <section class="alt cta-sec">
      <div class="wrap">
        <div class="cta-band cta-band--slim">
          <div>
            <span class="kicker">{C.kicker}</span>
            <h2>{C.heading}</h2>
          </div>
          <div class="ctas">
            <a class="btn btn-paper" href="/contact/">{C.primary} →</a>
            <a class="btn btn-glass" href={`mailto:${SITE.email}`}>{SITE.email}</a>
          </div>
        </div>
      </div>
    </section>
  </div>
</HomeLayout>
