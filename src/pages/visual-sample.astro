---
/**
 * 层次样例 v3 — PREVIEW BRANCH ONLY (never merges). Joe 二次澄清：灰的是
 * **容器外——整个页面的背景色**；容器内不动（产品图满铺到边，白底就白）。
 * 本页用生产现行的卡片（as-pcard，零改动）放在两档实测灰的页面底上对比。
 *
 * 实测：白底图背景 L* ≈ 98–100；现状页面底 #fff（L* 100）与照片同白 → 融。
 * 候选页面底：#eceef1（L* 94.0，Δ≈6）/ #e6e9ed（L* 92.2，Δ≈7.8）。
 */
import { Image } from 'astro:assets';
import LightBase from '../layouts/LightBase.astro';
import img1 from '../assets/products/co2-tvoc-hcho-desktop-monitor.webp';
import img2 from '../assets/products/wide-screen-co2-monitor.webp';
import img3 from '../assets/products/portable-co-alarm.webp';

const cards = [
  { img: img1, meta: 'Desktop · AS-D3', name: 'CO2 / TVOC / HCHO desktop monitor with traffic-light display' },
  { img: img2, meta: 'Desktop · AS-D9', name: 'Wide-screen CO2 monitor with ambient light bar' },
  { img: img3, meta: 'Portable · AS-P1', name: 'Portable CO alarm with clip mount' },
];
---

<LightBase
  title="Visual sample — internal"
  description="Internal sample: page background grey outside the containers, containers untouched. Not a public page."
  noindex
>
  <section style="background:#fff;padding:120px 0 64px">
    <div class="as-container">
      <div class="as-sechead">
        <p class="as-eyebrow">Internal sample v3</p>
        <h1 class="as-h2">页面底色调灰，容器一律不动 · 三档对比</h1>
        <p class="as-sub">
          卡片是生产现行的（照片满铺到边、灰文字区，零改动）。变的只有页面背景：
          白底图背景实测 L* 98–100，页面底从 #fff 依次换成 #eceef1（Δ≈6）和 #e6e9ed（Δ≈7.8）。
        </p>
      </div>
      <p class="vs-label">① 现状：页面底 #fff —— 白底图与页面融为一体</p>
      <div class="as-pgrid" style="max-width:1000px">
        {
          cards.map((c) => (
            <a class="as-pcard" href="#" onclick="return false">
              <span class="as-stage">
                <Image src={c.img} alt={c.name} widths={[480]} sizes="320px" loading="eager" />
              </span>
              <span class="as-pcard__body">
                <span class="as-pcard__meta">{c.meta}</span>
                <span class="as-pcard__name">{c.name}</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section style="background:#eceef1;padding:64px 0">
    <div class="as-container">
      <p class="vs-label">② 推荐：页面底 #eceef1（L* 94.0，Δ≈6）—— 卡片浮出，整体仍轻</p>
      <div class="as-pgrid" style="max-width:1000px">
        {
          cards.map((c) => (
            <a class="as-pcard" href="#" onclick="return false">
              <span class="as-stage">
                <Image src={c.img} alt={c.name} widths={[480]} sizes="320px" loading="eager" />
              </span>
              <span class="as-pcard__body">
                <span class="as-pcard__meta">{c.meta}</span>
                <span class="as-pcard__name">{c.name}</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section style="background:#e6e9ed;padding:64px 0 120px">
    <div class="as-container">
      <p class="vs-label">③ 备选：页面底 #e6e9ed（L* 92.2，Δ≈7.8）—— 分层更重一档</p>
      <div class="as-pgrid" style="max-width:1000px">
        {
          cards.map((c) => (
            <a class="as-pcard" href="#" onclick="return false">
              <span class="as-stage">
                <Image src={c.img} alt={c.name} widths={[480]} sizes="320px" loading="eager" />
              </span>
              <span class="as-pcard__body">
                <span class="as-pcard__meta">{c.meta}</span>
                <span class="as-pcard__name">{c.name}</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</LightBase>

<style>
  .vs-label {
    font-size: var(--as-fs-compact);
    font-weight: 600;
    color: var(--as-ink);
    margin-bottom: 16px;
  }
</style>
