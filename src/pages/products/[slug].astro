---
/**
 * /products/<model>/ — Design System v1 (真源 airsonde-design/product-detail-v1.html, the AK34
 * sample Joe signed off item by item; 55 pages share the template). Joe's named priority page.
 *
 * hero (same showroom photo + heading as /products/; the heading is a div, NOT an h1)
 *  → wash band: back pill + model (the page's ONLY h1) / gallery + info column
 *  → What it is / The working details (white, 2-column highlight cards)
 *  → Related (wash, same-category cards) → footer flush.
 *
 * Unchanged from before, byte for byte: getStaticPaths, <title>, description, Product +
 * BreadcrumbList JSON-LD, og:image. Data never renders supplierRef or moq.
 * Certification names are allowed in the spec table (and its JSON-LD twin) only —
 * scripts/check-dist.mjs 2c strips exactly <div class="glance">…</table></div> before scanning.
 */
import { Image, getImage } from 'astro:assets';
import type { GetStaticPaths } from 'astro';
import HomeLayout from '../../layouts/HomeLayout.astro';
import '../../styles/product-detail-v1.css';
import { CONTACT_V1, HOME_V4, PRODUCTS_PAGE, SITE } from '../../data/site';
import { stripLenticular } from '../../lib/text';
import { breadcrumbSchema, productSchema } from '../../lib/jsonld';
import { chipLabel } from '../../lib/catalog-filters';
import {
  categoryLabel,
  getPublishedProducts,
  headlineSensors,
  modelPath,
  productHref,
  resolveProductImage,
  sensorLabels,
  tryResolveProductImage,
} from '../../lib/products';
import heroPhoto from '../../assets/photos/products-hero-showroom-v6.webp';

/**
 * W29: the address is the model, not the record's slug. The duplicate check is an invariant
 * guard (getPublishedProducts already drops the second record and names both).
 */
export const getStaticPaths = (async () => {
  const products = await getPublishedProducts();
  const seen = new Map<string, string>();
  for (const product of products) {
    const path = modelPath(product.data.model);
    const previous = seen.get(path);
    if (previous) {
      throw new Error(
        `[products] two published products both want /products/${path}/: ` +
          `"${previous}" and "${product.data.slug}" (model ${JSON.stringify(product.data.model)}). ` +
          `Models are addresses now, so they have to be unique — rename one in the admin.`,
      );
    }
    seen.set(path, product.data.slug);
  }
  return products.map((product) => ({
    params: { slug: modelPath(product.data.model) },
    props: { product, siblings: products.filter((p) => p.data.slug !== product.data.slug) },
  }));
}) satisfies GetStaticPaths;

const { product, siblings } = Astro.props;
const { name, model, category, sensors, highlights, specs, images } = product.data;
const P = PRODUCTS_PAGE;

// ── gallery ────────────────────────────────────────────────────────────────────────────
const main = resolveProductImage(images.main);
// a gallery file that has not arrived yet costs one thumbnail, not the page and not the build
const missingGallery = (images.gallery ?? []).filter((path) => !tryResolveProductImage(path));
if (missingGallery.length > 0) {
  console.warn(
    `[products/${product.data.slug}] ${missingGallery.length} gallery image(s) are not in src/assets/ and are skipped: ${missingGallery.join(', ')}`,
  );
}
const gallery = (images.gallery ?? [])
  .map((path) => ({ src: tryResolveProductImage(path), path }))
  .filter((g): g is { src: ImageMetadata; path: string } => g.src !== null);
const allImages = [main, ...gallery.map((g) => g.src)];
// thumbnails and arrows only when there is something to page through (1 image = stage only)
const hasThumbs = allImages.length > 1;
// full-size URL per image so a thumbnail click swaps the stage without shipping every variant
const fullUrls = await Promise.all(
  allImages.map(async (src) => (await getImage({ src, width: 960, format: 'webp' })).src),
);

// ── specifications ─────────────────────────────────────────────────────────────────────
// Joe 2026-09-03: "Readings" repeats the Sensing chips — dropped at render time, record untouched
const isReadings = (key: string) => key.trim().toLowerCase() === 'readings';
// design: labels start with a capital; a trailing CJK tag such as "认证" comes off the value;
// "*" between measurements renders as " × " (Joe 2026-09-05) — render-time only, the record keeps "*"
const labelOf = (key: string) => key.trim().charAt(0).toUpperCase() + key.trim().slice(1);
const valueOf = (key: string, value: string) => {
  const v = /certif/i.test(key) ? value.replace(/[　-〿㐀-鿿＀-￯]+\s*$/u, '') : value;
  return v.replace(/\s*\*\s*/g, ' × ').trim();
};
const specEntries = Object.entries(specs ?? {}).filter(([key]) => !isReadings(key));
const hasFormFactor = specEntries.some(([key]) => key.trim().toLowerCase() === 'form factor');
const specRows: [string, string][] = [
  ...(hasFormFactor ? [] : [['Form factor', categoryLabel(category)] as [string, string]]),
  ...specEntries.map(([key, value]) => [labelOf(key), valueOf(key, value)] as [string, string]),
];

// ── highlights → cards ─────────────────────────────────────────────────────────────────
// one admin textarea, one line per card: "Title — body" splits into a titled card; a
// 【Label】body line (CJK source) does the same; anything else is a body-only card.
type Feat = { title?: string; body: string };
const featOf = (raw: string): Feat => {
  const lent = raw.match(/^\s*【([^】]+)】\s*(.*)$/s);
  if (lent) return { title: lent[1].trim(), body: lent[2].trim() };
  const i = raw.indexOf(' — ');
  if (i > 0) return { title: raw.slice(0, i).trim(), body: raw.slice(i + 3).trim() };
  return { body: stripLenticular(raw).trim() };
};
const feats = (highlights ?? []).map(featOf).filter((f) => f.body || f.title);

// ── related ────────────────────────────────────────────────────────────────────────────
const related = siblings.filter((p) => p.data.category === category).slice(0, 3);
const relatedHeading =
  category === 'other' ? 'More from the catalogue' : `Other ${categoryLabel(category).toLowerCase()} monitors`;

// ── head (unchanged) ───────────────────────────────────────────────────────────────────
const title = `${name} (${model}) — OEM / ODM | ${SITE.brand}`;
const description =
  product.data.metaDescription?.trim() ||
  `${name}, model ${model}. ${sensorLabels(sensors).join(', ')} sensing. Built to order for OEM and ODM programmes under your own brand.`;
const schemaImages = await Promise.all(
  [main, ...gallery.map((g) => g.src)].map(async (src) => {
    const built = await getImage({ src, width: 960, format: 'webp' });
    return new URL(built.src, SITE.url).href;
  }),
);
const schemas = [
  productSchema(product, schemaImages),
  breadcrumbSchema([
    { name: 'Home', url: `${SITE.url}/` },
    { name: 'Products', url: `${SITE.url}/products/` },
    { name: model, url: `${SITE.url}${productHref(product)}` },
  ]),
];

// "Reply within 2 business days" — same derivation as the contact form's note, without the full stop
const note = CONTACT_V1.replyNote.replace(/\.$/, '');
---

<HomeLayout title={title} description={description} schemas={schemas} ogImage={schemaImages[0]} footerFlush>
  <div class="pdp">
    <div class="phero">
      <Image
        src={heroPhoto}
        alt="Showroom with a panelled, downlit wall on the left and air-quality monitors on two lit wall shelves under the airsonde wordmark, more models on a rounded display island below"
        class="bg"
        widths={[768, 1280, 1600, 2400]}
        sizes="100vw"
        quality={72}
        loading="eager"
        fetchpriority="high"
      />
      <div class="veil" aria-hidden="true"></div>
      <div class="wrap">
        <span class="kicker">{HOME_V4.products.kicker}</span>
        <div class="htitle">{P.heroHeading}</div>
      </div>
    </div>

    <div class="detailband">
      <div class="wrap backrow">
        <a class="back" href="/products/">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6" /></svg>
          {HOME_V4.products.allLabel}
        </a>
        <h1 class="pmodel">{model}</h1>
      </div>

      <div class="wrap detail">
        <div class="gallery">
          <div class="stage">
            <Image src={main} alt={name} widths={[480, 720, 960]} sizes="(min-width: 1024px) 560px, 90vw" loading="eager" data-pdp-main />
            {
              hasThumbs && (
                <>
                  <button type="button" class="snav prev" data-pdp-prev aria-label={P.gallery.prev}>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg>
                  </button>
                  <button type="button" class="snav next" data-pdp-next aria-label={P.gallery.next}>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
                  </button>
                </>
              )
            }
          </div>
          {
            hasThumbs && (
              <div class="thumbs" data-pdp-thumbs>
                {allImages.map((src, i) => (
                  <button
                    type="button"
                    class:list={{ on: i === 0 }}
                    data-full={fullUrls[i]}
                    aria-label={`${P.gallery.view} ${i + 1} of ${allImages.length}`}
                    aria-current={i === 0 ? 'true' : 'false'}
                    hidden={i >= 5}
                  >
                    <Image src={src} alt="" widths={[160, 240]} sizes="120px" loading="lazy" />
                  </button>
                ))}
              </div>
            )
          }
        </div>

        <div class="info">
          <div class="pname" title={name}>{name}</div>
          <div class="glance">
            <h4>{P.sectionHeadings.specs}</h4>
            <table>
              <tbody>
                {
                  specRows.map(([k, v]) => (
                    <tr>
                      <td>{k}</td>
                      <td>{v}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
          <div class="sensing">
            <h4>{P.sectionHeadings.sensing}</h4>
            <div class="chips">{sensorLabels(sensors).map((s) => <span>{chipLabel(s)}</span>)}</div>
          </div>
          <div class="buy">
            <a class="btn btn-solid" href="/contact/">{P.enquire} {model} →</a>
            <span class="note">{note}</span>
          </div>
        </div>
      </div>
    </div>

    {
      feats.length > 0 && (
        <section class="featsec">
          <div class="wrap">
            <div class="sec-head">
              <span class="kicker">{P.sectionHeadings.highlights}</span>
              <h2>{P.sectionHeadings.whatHeading}</h2>
            </div>
            <div class="feats">
              {feats.map((f) => (
                <div class="feat">
                  {f.title && <h3>{f.title}</h3>}
                  {f.body && <p>{f.body}</p>}
                </div>
              ))}
            </div>
          </div>
        </section>
      )
    }

    {
      related.length > 0 && (
        <section class="relsec">
          <div class="wrap">
            <div class="sec-head">
              <span class="kicker">{P.sectionHeadings.relatedKicker}</span>
              <h2>{relatedHeading}</h2>
            </div>
            <div class="prod-row">
              {related.map((item) => (
                <a class="pcard" href={productHref(item)}>
                  <div class="ph">
                    <Image
                      src={resolveProductImage(item.data.images.main)}
                      alt={item.data.name}
                      widths={[320, 480, 640]}
                      sizes="(min-width: 1000px) 363px, (min-width: 640px) 45vw, 90vw"
                      loading="lazy"
                    />
                  </div>
                  <div class="tx">
                    <span class="model">{item.data.model}</span>
                    <h3 title={item.data.name}>{item.data.name}</h3>
                    <div class="chips">{headlineSensors(item, 4).map((s) => <span>{chipLabel(s)}</span>)}</div>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </section>
      )
    }
  </div>
</HomeLayout>

<script>
  // Gallery: fixed five-slot thumbnail window + stage arrows; the window follows the selection
  // (design script). Swapping the stage src means dropping srcset/sizes so the browser stops
  // picking from the old candidate list.
  const thumbs = document.querySelector<HTMLElement>('[data-pdp-thumbs]');
  const stage = document.querySelector<HTMLImageElement>('[data-pdp-main]');
  if (thumbs && stage) {
    const btns = [...thumbs.querySelectorAll<HTMLButtonElement>('button')];
    const WIN = 5;
    const N = btns.length;
    let cur = 0;
    let win = 0;
    const render = () => {
      if (cur < win) win = cur;
      if (cur > win + WIN - 1) win = cur - WIN + 1;
      win = Math.max(0, Math.min(win, Math.max(0, N - WIN)));
      btns.forEach((b, i) => {
        b.hidden = !(i >= win && i < win + WIN);
        const on = i === cur;
        b.classList.toggle('on', on);
        b.setAttribute('aria-current', String(on));
      });
      const full = btns[cur]?.dataset.full;
      if (full) {
        stage.removeAttribute('srcset');
        stage.removeAttribute('sizes');
        stage.src = full;
      }
    };
    btns.forEach((b, i) =>
      b.addEventListener('click', () => {
        cur = i;
        render();
      }),
    );
    document.querySelector('[data-pdp-prev]')?.addEventListener('click', () => {
      cur = (cur - 1 + N) % N;
      render();
    });
    document.querySelector('[data-pdp-next]')?.addEventListener('click', () => {
      cur = (cur + 1) % N;
      render();
    });
    render();
  }
</script>
