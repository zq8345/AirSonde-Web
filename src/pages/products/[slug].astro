---
/**
 * /products/[slug]/ — light skin (W4 products批). Skin only: getStaticPaths,
 * titles, descriptions, Product/Breadcrumb JSON-LD and the og:image pipeline
 * are byte-for-byte the dark version's logic. Data never renders supplierRef
 * or moq; draft products never reach getStaticPaths.
 */
import { Image, getImage } from 'astro:assets';
import type { GetStaticPaths } from 'astro';
import LightBase from '../../layouts/LightBase.astro';
import LightProductCard from '../../components/LightProductCard.astro';
import { PRODUCTS_PAGE, SITE } from '../../data/site';
import { breadcrumbSchema, productSchema } from '../../lib/jsonld';
import {
  categoryLabel,
  getPublishedProducts,
  modelPath,
  productHref,
  resolveProductImage,
  sensorLabels,
  tryResolveProductImage,
} from '../../lib/products';

/**
 * W29: the address is the model, not the record's slug. The slug is still the
 * record's identity in the content collection and in the admin — it just
 * stopped being the URL.
 * ⚠️ The duplicate check below is now unreachable from anything an admin does
 * — getPublishedProducts drops the second record and names both, so two of
 * them can no longer arrive here. It stays as an invariant guard: if it ever
 * fires it means that filter has a bug, which is a programming error, and a
 * throw is the right answer to those. It is not the guard against Joe typing
 * a duplicate model; that one belongs in the admin, at the moment he types it.
 */
export const getStaticPaths = (async () => {
  const products = await getPublishedProducts();
  const seen = new Map<string, string>();
  for (const product of products) {
    const path = modelPath(product.data.model);
    const previous = seen.get(path);
    if (previous) {
      throw new Error(
        `[products] two published products both want /products/${path}/: ` +
          `"${previous}" and "${product.data.slug}" (model ${JSON.stringify(product.data.model)}). ` +
          `Models are addresses now, so they have to be unique — rename one in the admin.`,
      );
    }
    seen.set(path, product.data.slug);
  }
  return products.map((product) => ({
    params: { slug: modelPath(product.data.model) },
    props: { product, siblings: products.filter((p) => p.data.slug !== product.data.slug) },
  }));
}) satisfies GetStaticPaths;

const { product, siblings } = Astro.props;
const { name, model, category, sensors, highlights, specs, images } = product.data;

const main = resolveProductImage(images.main);
// ⚠️ A gallery file that has not arrived yet costs one thumbnail, not the
// page and not the build. (The main image is different: a record missing it
// never reaches this page — getPublishedProducts drops it.)
const missingGallery = (images.gallery ?? []).filter((path) => !tryResolveProductImage(path));
if (missingGallery.length > 0) {
  console.warn(
    `[products/${product.data.slug}] ${missingGallery.length} gallery image(s) are not in src/assets/ and are skipped: ${missingGallery.join(', ')}`,
  );
}
const gallery = (images.gallery ?? [])
  .map((path) => ({ src: tryResolveProductImage(path), path }))
  .filter((g): g is { src: ImageMetadata; path: string } => g.src !== null);
/**
 * W19: one ordered list drives the stage and the thumbnail row.
 * ⚠️ The strip appears only when there really is more than one image — 17 of
 * the 23 records carry no gallery, and a single thumbnail duplicating the
 * stage reads as a bug rather than a control.
 */
const allImages = [main, ...gallery.map((g) => g.src)];
const hasThumbs = allImages.length > 1;
// Full-size URL per image so a thumbnail click can swap the stage without
// shipping every variant up front (the first image keeps its responsive
// srcset, which is the LCP path).
const fullUrls = await Promise.all(
  allImages.map(async (src) => (await getImage({ src, width: 960, format: 'webp' })).src),
);

const related = siblings.filter((p) => p.data.category === category).slice(0, 3);
// "Other other monitors" was live for the 'other' category — special-case it
const relatedHeading =
  category === 'other' ? 'More from the catalogue' : `Other ${categoryLabel(category).toLowerCase()} monitors`;

/**
 * 总工 2026-09-03: five records' highlights arrive with CJK lenticular
 * brackets — 【Label】Text — copied from Chinese source material. Inter has no
 * glyph for U+3010/U+3011, so they render as tofu boxes. Stripped at render
 * time, here and only here (⛔ not a site-wide text pipe; ⛔ the JSON stays
 * as the colleague wrote it). The closing bracket becomes a single space
 * when the text runs straight on ("】This all-in-one…", 10 of the 29 lines),
 * otherwise nothing — so no label glues to its sentence and no line gains
 * a second space.
 */
const stripLenticular = (line: string) =>
  line.replace(/【/g, '').replace(/】(?=\S)/g, ' ').replace(/】/g, '');

// Joe (2026-09-03): the "Readings" row repeats the Sensing list that sits
// directly above the table — drop it at render time. ⛔ The product JSON is
// content, not ours to edit; the key stays in the records untouched. Match
// is trimmed and case-insensitive so an admin's "readings " still goes.
const isReadings = (key: string) => key.trim().toLowerCase() === 'readings';
const specRows = specs ? Object.fromEntries(Object.entries(specs).filter(([key]) => !isReadings(key))) : undefined;

// Admin-created records ship without specs yet; the at-a-glance table falls
// back to rows derived purely from data on hand — nothing invented. A record
// whose only spec was Readings takes the same fallback.
const glance =
  specRows && Object.keys(specRows).length > 0
    ? specRows
    : { Model: model, 'Form factor': categoryLabel(category), Sensing: sensorLabels(sensors).join(', ') };

const title = `${name} (${model}) — OEM / ODM | ${SITE.brand}`;
// Joe 2026-09-03: a hand-written metaDescription wins when present; blank or
// absent falls back to the derived sentence, byte-for-byte as before.
// LightBase feeds this one string to <meta name="description">,
// og:description and twitter:description alike (verified), so this is the
// single point of change.
const description =
  product.data.metaDescription?.trim() ||
  `${name}, model ${model}. ${sensorLabels(sensors).join(', ')} sensing. Built to order for OEM and ODM programmes under your own brand.`;

// Absolute URLs of the emitted assets, so structured data points at files that
// actually exist rather than at the source paths.
const schemaImages = await Promise.all(
  [main, ...gallery.map((g) => g.src)].map(async (src) => {
    const built = await getImage({ src, width: 960, format: 'webp' });
    return new URL(built.src, SITE.url).href;
  }),
);

const schemas = [
  productSchema(product, schemaImages),
  breadcrumbSchema([
    { name: 'Home', url: `${SITE.url}/` },
    { name: 'Products', url: `${SITE.url}/products/` },
    // W23②: the visible trail's last step is the model, so the structured data
    // says the same thing rather than a second copy of the full title — that is
    // still carried by the h1, <title>, og:title and Product.name.
    { name: model, url: `${SITE.url}${productHref(product)}` },
  ]),
];
---

<LightBase title={title} description={description} schemas={schemas} ogImage={schemaImages[0]}>
  <div class="as-container" style="padding-top:calc(var(--as-header-h) + 26px);padding-bottom:72px">
    {/* W23②: a way back plus the model, not a second copy of the title — the
        model is short, stable and identifies the product on its own. ⛔ Display
        only: it reads the existing `model` field, nothing is written. */}
    <nav aria-label="Breadcrumb" class="as-crumb">
      <a href="/products/" class="as-crumb__back">
        <span class="as-crumb__arw" aria-hidden="true">←</span>
        Products
      </a>
      <span class="as-crumb__sep">/</span>
      <span class="as-crumb__current">{model}</span>
    </nav>

    <div class="as-pdp">
      <div class="as-pdp__media">
        <div class="as-pdp__stage">
          <Image
            src={main}
            alt={name}
            widths={[480, 720, 960]}
            sizes="(min-width: 1024px) 560px, 90vw"
            loading="eager"
            data-pdp-main
          />
          {/* W22①: real <button>s, so they are tabbable and fire on Enter —
              the thumbnails alone were mouse-only. Rendered only when there
              is something to page through. */}
          {
            hasThumbs && (
              <>
                <button type="button" class="as-pdp__nav as-pdp__nav--prev" data-pdp-prev aria-label="Previous image">
                  <span aria-hidden="true">‹</span>
                </button>
                <button type="button" class="as-pdp__nav as-pdp__nav--next" data-pdp-next aria-label="Next image">
                  <span aria-hidden="true">›</span>
                </button>
              </>
            )
          }
        </div>

        {
          hasThumbs && (
            <ul class="as-pdp__thumbs" data-pdp-thumbs>
              {allImages.map((src, i) => (
                <li>
                  <button
                    type="button"
                    class:list={['as-pdp__thumb', { 'is-active': i === 0 }]}
                    data-full={fullUrls[i]}
                    aria-label={`View image ${i + 1} of ${allImages.length}`}
                    aria-current={i === 0 ? 'true' : 'false'}
                  >
                    <Image src={src} alt="" widths={[160, 240]} sizes="120px" loading="lazy" />
                  </button>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      <div class="as-pdp__info">
        <p class="as-pdp__meta">{categoryLabel(category)} · {model}</p>
        {/* W23③: 23 of the 24 records are ≤46 characters and keep the full h1;
            only a genuinely long title steps down one notch. Threshold sits in
            the measured gap (46 → 201), so it is not a hair-trigger. */}
        <h1 class:list={['as-pdp__title', { 'as-pdp__title--long': name.length > 70 }]}>{name}</h1>

        <h2 class="as-pdp__h">{PRODUCTS_PAGE.sectionHeadings.sensing}</h2>
        <ul class="as-sensor-pills">
          {sensorLabels(sensors).map((sensor) => <li>{sensor}</li>)}
        </ul>

        <h2 class="as-pdp__h">{PRODUCTS_PAGE.sectionHeadings.specs}</h2>
        <dl class="as-spec">
          {
            Object.entries(glance).map(([key, value]) => (
              <div>
                <dt>{key}</dt>
                <dd>{value}</dd>
              </div>
            ))
          }
        </dl>

        {/* W26: the enquiry line and its grey panel are gone; the button is
            the whole of the column's foot and is what aligns with the
            thumbnail strip. */}
        <a href="/contact/" class="as-btn as-btn--primary as-pdp__enquire">
          Enquire about {model}
          <span class="as-arw" aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    {/* W22②: the highlights are full paragraphs on real records — 7 of them,
        up to 382 characters — and in the right column they stretched it to
        1540px against the images' 762px. They get the full width instead.
        ⛔ Copy untouched; this moves the block, nothing else. */}
    {
      highlights && highlights.length > 0 && (
        <section class="as-pdp__about">
          <h2 class="as-pdp__h">{PRODUCTS_PAGE.sectionHeadings.highlights}</h2>
          <ul class="as-pdp__list">
            {highlights.map((line) => (
              <li>{stripLenticular(line)}</li>
            ))}
          </ul>
        </section>
      )
    }

    {
      related.length > 0 && (
        <section style="margin-top:88px">
          <div class="as-sechead">
            <h2 class="as-h2">{relatedHeading}</h2>
          </div>
          <div class="as-pgrid">
            {related.map((item) => (
              <LightProductCard product={item} />
            ))}
          </div>
        </section>
      )
    }
  </div>
</LightBase>

<script>
  // W19: thumbnails switch the stage image (wanew's behaviour). Swapping the
  // src means dropping srcset/sizes, otherwise the browser keeps picking from
  // the old candidate list.
  // W22: the same state is now driven by prev/next buttons too, and the strip
  // is a single scrolling row — so selecting an image must also bring its
  // thumbnail into view, or paging past the visible ones looks broken.
  const thumbs = document.querySelector<HTMLElement>('[data-pdp-thumbs]');
  const stage = document.querySelector<HTMLImageElement>('[data-pdp-main]');
  if (thumbs && stage) {
    const buttons = [...thumbs.querySelectorAll<HTMLButtonElement>('.as-pdp__thumb')];
    let index = 0;

    const show = (next: number, scrollIntoView: boolean) => {
      const clamped = (next + buttons.length) % buttons.length;
      const button = buttons[clamped];
      const full = button?.dataset.full;
      if (!button || !full) return;
      index = clamped;
      stage.removeAttribute('srcset');
      stage.removeAttribute('sizes');
      stage.src = full;
      for (const other of buttons) {
        const on = other === button;
        other.classList.toggle('is-active', on);
        other.setAttribute('aria-current', String(on));
      }
      if (!scrollIntoView) return;
      // Keep the active thumbnail inside the strip's own scroll box; working
      // from the element's offset rather than scrollIntoView avoids yanking
      // the whole page when the strip is already visible.
      // ⚠️ Measured: assigning scrollLeft does nothing while the element has
      // scroll-behavior: smooth — it stayed at 0 even 800ms later. scrollTo()
      // is the call that actually moves it.
      const strip = thumbs.getBoundingClientRect();
      const item = button.getBoundingClientRect();
      let left = thumbs.scrollLeft;
      if (item.left < strip.left) {
        left += item.left - strip.left - 12;
      } else if (item.right > strip.right) {
        left += item.right - strip.right + 12;
      } else {
        return;
      }
      thumbs.scrollTo({ left, behavior: 'smooth' });
      // ⚠️ Measured: smooth scrolling does not always run (it never advanced
      // at all in the environment this was verified in). Whether the active
      // thumbnail is reachable must not depend on an animation, so snap to
      // the target if the animation has not taken it there.
      window.setTimeout(() => {
        if (Math.abs(thumbs.scrollLeft - left) > 4) {
          thumbs.scrollTo({ left, behavior: 'instant' as ScrollBehavior });
        }
      }, 420);
    };

    thumbs.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('.as-pdp__thumb');
      if (!button) return;
      show(buttons.indexOf(button), false);
    });

    document.querySelector('[data-pdp-prev]')?.addEventListener('click', () => show(index - 1, true));
    document.querySelector('[data-pdp-next]')?.addEventListener('click', () => show(index + 1, true));
  }
</script>
