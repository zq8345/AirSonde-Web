---
/**
 * /products/ v1 — Design System v1 (真源 airsonde-design/products-v1.html, DESIGN.md wins
 * on conflict). Skin + filter UX; the crawlable surface is unchanged: same title,
 * description, canonical, ItemList + BreadcrumbList JSON-LD as before.
 *
 * 🔴 Filters derive from the catalog (src/lib/catalog-filters.ts), not from the design's
 * hand-typed map: every count, every pill, every card's sensor membership is rendered
 * from the product records and re-read on the client from data attributes.
 *
 * Filter state lives in the URL (?category=…&sensor=…) so a filtered view can be
 * reloaded or shared; unknown values fall back to "all".
 */
import { Image } from 'astro:assets';
import HomeLayout from '../../layouts/HomeLayout.astro';
import '../../styles/products-v1.css';
import { HOME_V4, META, PRODUCTS_PAGE, PRODUCTS_V1, SITE } from '../../data/site';
// Brand showroom render (v6, 2880x1200), the same image the previous skin used. It is a
// brand image, not documentary evidence of a facility — page copy must not call it one.
import heroPhoto from '../../assets/photos/products-hero-showroom-v6.webp';
import { breadcrumbSchema, itemListSchema } from '../../lib/jsonld';
import {
  categoryLabel,
  getPublishedProducts,
  headlineSensors,
  productHref,
  resolveProductImage,
} from '../../lib/products';
import { categoriesInTaxonomyOrder, chipLabel, listOrder, sensorGroupsFor, sensorKeysOf } from '../../lib/catalog-filters';

// JSON-LD keeps the collection's own (name) order, as before; only the visible grid is re-ordered.
const published = await getPublishedProducts();
const products = listOrder(published, HOME_V4.products.featured.map((f) => f.slug));
const categories = categoriesInTaxonomyOrder(products);
const sensorGroups = sensorGroupsFor(products);
const countOf = (category: string) => products.filter((p) => p.data.category === category).length;

const schemas = [
  itemListSchema(published),
  breadcrumbSchema([
    { name: 'Home', url: `${SITE.url}/` },
    { name: 'Products', url: `${SITE.url}/products/` },
  ]),
];

const P = HOME_V4.products; // kicker + heading: same words as the homepage section, one source
const C = HOME_V4.cta;
---

<HomeLayout title={META.products.title} description={META.products.description} schemas={schemas}>
  <div class="phero">
    <Image
      src={heroPhoto}
      alt="Showroom with a panelled, downlit wall on the left and air-quality monitors on two lit wall shelves under the airsonde wordmark, more models on a rounded display island below"
      class="bg"
      widths={[768, 1280, 1600, 2400]}
      sizes="100vw"
      quality={72}
      loading="eager"
      fetchpriority="high"
    />
    <div class="veil" aria-hidden="true"></div>
    <div class="wrap">
      <span class="kicker">{P.kicker}</span>
      {/* Joe 2026-09-05: the same sentence heads /products/ and every product detail hero */}
      <h1>{PRODUCTS_PAGE.heroHeading}</h1>
    </div>
  </div>

  <section class="prods prods--list">
    <div class="fwrap">
      <div class="wrap">
        <div class="fbar">
          <div class="filters" id="filters" role="group" aria-label="Filter by category">
            <button type="button" class="on" data-f="all" aria-pressed="true">
              {PRODUCTS_V1.allCategories} <i class="n">({products.length})</i>
            </button>
            {
              categories.map((category) => (
                <button type="button" data-f={category} aria-pressed="false">
                  {categoryLabel(category)} <i class="n">({countOf(category)})</i>
                </button>
              ))
            }
          </div>
        </div>
        <div class="sfilters" id="sfilters" role="group" aria-label="Filter by sensor">
          <button type="button" class="on" data-s="all" aria-pressed="true">{PRODUCTS_V1.allSensors}</button>
          {
            sensorGroups.map((g) => (
              <button type="button" data-s={g.key} aria-pressed="false">
                {g.label}
              </button>
            ))
          }
        </div>
      </div>
    </div>

    <div class="wrap">
      <div class="prod-row" id="grid">
        {
          products.map((product) => {
            const { name, model, category, images } = product.data;
            return (
              <a
                class="pcard"
                href={productHref(product)}
                data-c={category}
                data-s={sensorKeysOf(product, sensorGroups).join(' ')}
              >
                <div class="ph">
                  <Image
                    src={resolveProductImage(images.main)}
                    alt={name}
                    widths={[320, 480, 640]}
                    sizes="(min-width: 1000px) 363px, (min-width: 640px) 45vw, 90vw"
                    loading="lazy"
                  />
                </div>
                <div class="tx">
                  <span class="model">{model}</span>
                  <h3 title={name}>{name}</h3>
                  <div class="chips">
                    {headlineSensors(product, 4).map((s) => <span>{chipLabel(s)}</span>)}
                  </div>
                </div>
              </a>
            );
          })
        }
      </div>
      <p id="no-results" class="no-results" hidden>{PRODUCTS_V1.empty}</p>
    </div>
  </section>

  <div class="wrap cta-wrap">
    <div class="cta-band cta-band--slim">
      <div>
        <span class="kicker">{C.kicker}</span>
        <h2>{C.heading}</h2>
      </div>
      <div class="ctas">
        <a class="btn btn-solid btn-paper" href="/contact/">{C.primary} →</a>
        <a class="btn btn-glass" href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </div>
    </div>
  </div>
</HomeLayout>

<script>
  // Category × sensor AND filter. The card's data-c / data-s were rendered from the
  // catalog, so this re-derives the same answer the build did — no second list.
  const cards = [...document.querySelectorAll<HTMLElement>('#grid .pcard')];
  const catBtns = [...document.querySelectorAll<HTMLButtonElement>('#filters button')];
  const senBtns = [...document.querySelectorAll<HTMLButtonElement>('#sfilters button')];
  const empty = document.getElementById('no-results');

  const matches = (card: HTMLElement, cat: string, sen: string) =>
    (cat === 'all' || card.dataset.c === cat) &&
    (sen === 'all' || (card.dataset.s ?? '').split(' ').includes(sen));

  const known = (btns: HTMLButtonElement[], attr: 'f' | 's', v: string | null) =>
    v && btns.some((b) => b.dataset[attr] === v) ? v : 'all';

  const params = new URLSearchParams(location.search);
  let cat = known(catBtns, 'f', params.get('category'));
  let sen = known(senBtns, 's', params.get('sensor'));

  const apply = () => {
    let shown = 0;
    for (const c of cards) {
      const on = matches(c, cat, sen);
      c.hidden = !on;
      if (on) shown++;
    }
    if (empty) empty.hidden = shown > 0;

    // category counts follow the current sensor choice (design: 数量集成进分类胶囊)
    for (const b of catBtns) {
      const f = b.dataset.f ?? 'all';
      const n = cards.filter((c) => matches(c, f, sen)).length;
      const el = b.querySelector('.n');
      if (el) el.textContent = `(${n})`;
      const active = f === cat;
      b.classList.toggle('on', active);
      b.setAttribute('aria-pressed', String(active));
    }
    for (const b of senBtns) {
      const active = (b.dataset.s ?? 'all') === sen;
      b.classList.toggle('on', active);
      b.setAttribute('aria-pressed', String(active));
    }

    const q = new URLSearchParams();
    if (cat !== 'all') q.set('category', cat);
    if (sen !== 'all') q.set('sensor', sen);
    const qs = q.toString();
    history.replaceState(null, '', location.pathname + (qs ? `?${qs}` : '') + location.hash);
  };

  catBtns.forEach((b) =>
    b.addEventListener('click', () => {
      cat = b.dataset.f ?? 'all';
      apply();
    }),
  );
  senBtns.forEach((b) =>
    b.addEventListener('click', () => {
      sen = b.dataset.s ?? 'all';
      apply();
    }),
  );
  apply();
</script>
