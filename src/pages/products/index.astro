---
/**
 * /products/ — light skin (W4 products批, Joe 点名). Skin only: the schemas
 * (ItemList + BreadcrumbList), title, description and the client-side
 * category filter behaviour are unchanged from the dark version.
 */
import LightBase from '../../layouts/LightBase.astro';
import LightProductCard from '../../components/LightProductCard.astro';
import { META, PRODUCTS_PAGE, SITE } from '../../data/site';
import { breadcrumbSchema, itemListSchema } from '../../lib/jsonld';
import { categoriesOf, categoryLabel, getPublishedProducts } from '../../lib/products';

const products = await getPublishedProducts();
const categories = categoriesOf(products);

const schemas = [
  itemListSchema(products),
  breadcrumbSchema([
    { name: 'Home', url: `${SITE.url}/` },
    { name: 'Products', url: `${SITE.url}/products/` },
  ]),
];
---

<LightBase title={META.products.title} description={META.products.description} schemas={schemas}>
  <section class="as-section" style="padding-bottom:0">
    <div class="as-container as-pagehead">
      <p class="as-eyebrow">{PRODUCTS_PAGE.eyebrow}</p>
      <h1 class="as-pagehead__title">{PRODUCTS_PAGE.heading}</h1>
      <p class="as-pagehead__lead">{PRODUCTS_PAGE.intro}</p>
    </div>
  </section>

  <section class="as-section">
    <div class="as-container">
      <div class="as-filterbar" role="group" aria-label={PRODUCTS_PAGE.filterLabel}>
        <button type="button" data-filter="all" class="as-filter is-active" aria-pressed="true">
          All<span class="as-filter__n">({products.length})</span>
        </button>
        {
          categories.map((category) => (
            <button type="button" data-filter={category} class="as-filter" aria-pressed="false">
              {categoryLabel(category)}
              <span class="as-filter__n">
                ({products.filter((p) => p.data.category === category).length})
              </span>
            </button>
          ))
        }
      </div>

      <div id="product-grid" class="as-pgrid as-pgrid--4" style="margin-top:32px">
        {
          products.map((product) => (
            <div data-category={product.data.category}>
              <LightProductCard product={product} />
            </div>
          ))
        }
      </div>

      <p id="no-results" class="as-sub" style="margin-top:32px" hidden>
        {PRODUCTS_PAGE.emptyState}
      </p>
    </div>
  </section>
</LightBase>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.as-filter');
  const cards = document.querySelectorAll<HTMLElement>('#product-grid > [data-category]');
  const empty = document.getElementById('no-results');

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const wanted = button.dataset.filter;
      buttons.forEach((other) => {
        const on = other === button;
        other.setAttribute('aria-pressed', String(on));
        other.classList.toggle('is-active', on);
      });
      let shown = 0;
      cards.forEach((card) => {
        const match = wanted === 'all' || card.dataset.category === wanted;
        card.hidden = !match;
        if (match) shown += 1;
      });
      if (empty) empty.hidden = shown > 0;
    });
  });
</script>
