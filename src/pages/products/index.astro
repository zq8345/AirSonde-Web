---
/**
 * /products/ — light skin (W4 products批, Joe 点名). Skin only: the schemas
 * (ItemList + BreadcrumbList), title, description and the client-side
 * category filter behaviour are unchanged from the dark version.
 */
import { Image } from 'astro:assets';
import LightBase from '../../layouts/LightBase.astro';
import LightProductCard from '../../components/LightProductCard.astro';
import { META, PRODUCTS_PAGE, SITE } from '../../data/site';
// Generated brand showroom scene. It is a brand image, not documentary
// evidence of a real AirSonde facility, so page copy must not describe it as
// such. Earlier showroom/reception renders remain for easy comparison.
// W38 (2026-08-28): v5, 2880x1200 (2.400:1), same spec as the homepage hero —
// quiet wall across the left 56%, wall shelves and display island on the
// right. ⚠️ Joe is still iterating on this render, so v2 stays on disk.
import heroPhoto from '../../assets/photos/products-hero-showroom-v5.webp';
import { breadcrumbSchema, itemListSchema } from '../../lib/jsonld';
import { categoriesOf, categoryLabel, getPublishedProducts } from '../../lib/products';

const products = await getPublishedProducts();
const categories = categoriesOf(products);

const schemas = [
  itemListSchema(products),
  breadcrumbSchema([
    { name: 'Home', url: `${SITE.url}/` },
    { name: 'Products', url: `${SITE.url}/products/` },
  ]),
];
---

<LightBase title={META.products.title} description={META.products.description} schemas={schemas}>
  <!--
    focus, measured on this render rather than carried over from v2:
    the "airsonde" wordmark sits at x 69.7-75.8%, y 29.4-31.9%, and it is the
    element that must survive every crop (the v2 hero cut it at 1680 and up).
    · Y 34%: at 2560x400 — the harshest crop, only 37.5% of the image height
      survives — the visible band is y 21.3-58.8%, leaving 8.1 points above the
      wordmark. 52% put that band at 32.5% and cut it.
    · X 72% below 768px: there the crop is horizontal, not vertical, and only
      ~39% of the image WIDTH is visible. X 50% clips the wordmark's right edge
      by 6.3 points; 72% keeps it whole with 5.9 to spare and still opens on
      quiet wall at the left.
  -->
  <!-- as-hero--openright: 蒙版 B — the wash fades out by x 78% so the display
       island shows through; the text side (0-38%) is unchanged. -->
  <section
    class="as-hero as-hero--page as-hero--openright as-hero--cap28"
    style="--hero-focus: 50% 34%; --hero-focus-narrow: 72% 34%"
  >
    <Image
      src={heroPhoto}
      alt="Empty showroom wall in warm daylight, with air-quality monitors arranged on two lit wall shelves under the airsonde wordmark and on a rounded display island below"
      class="as-hero__img"
      widths={[768, 1280, 1600, 2400]}
      sizes="100vw"
      quality={72}
      loading="eager"
      fetchpriority="high"
    />
    <div class="as-hero__wash" aria-hidden="true"></div>
    <div class="as-container as-hero__in">
      <p class="as-hero__eyebrow">{PRODUCTS_PAGE.eyebrow}</p>
      <h1 class="as-hero__title">{PRODUCTS_PAGE.heading}</h1>
      <p class="as-hero__lead">{PRODUCTS_PAGE.intro}</p>
    </div>
  </section>

  <section class="as-section">
    <div class="as-container">
      <div class="as-filterbar" role="group" aria-label={PRODUCTS_PAGE.filterLabel}>
        <button type="button" data-filter="all" class="as-filter is-active" aria-pressed="true">
          All<span class="as-filter__n">({products.length})</span>
        </button>
        {
          categories.map((category) => (
            <button type="button" data-filter={category} class="as-filter" aria-pressed="false">
              {categoryLabel(category)}
              <span class="as-filter__n">
                ({products.filter((p) => p.data.category === category).length})
              </span>
            </button>
          ))
        }
      </div>

      <div id="product-grid" class="as-pgrid as-pgrid--4" style="margin-top:32px">
        {
          products.map((product) => (
            <div data-category={product.data.category}>
              <LightProductCard product={product} />
            </div>
          ))
        }
      </div>

      <p id="no-results" class="as-sub" style="margin-top:32px" hidden>
        {PRODUCTS_PAGE.emptyState}
      </p>
    </div>
  </section>
</LightBase>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.as-filter');
  const cards = document.querySelectorAll<HTMLElement>('#product-grid > [data-category]');
  const empty = document.getElementById('no-results');

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const wanted = button.dataset.filter;
      buttons.forEach((other) => {
        const on = other === button;
        other.setAttribute('aria-pressed', String(on));
        other.classList.toggle('is-active', on);
      });
      let shown = 0;
      cards.forEach((card) => {
        const match = wanted === 'all' || card.dataset.category === wanted;
        card.hidden = !match;
        if (match) shown += 1;
      });
      if (empty) empty.hidden = shown > 0;
    });
  });
</script>
