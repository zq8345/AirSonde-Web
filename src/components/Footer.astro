---
import { NAV, SITE } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-white/10 bg-ink-950">
  <div class="mx-auto max-w-6xl px-5 py-12 sm:px-8">
    <div class="flex flex-col gap-8 sm:flex-row sm:items-start sm:justify-between">
      <div class="max-w-sm">
        <p class="text-lg font-semibold tracking-tight text-ink-50">{SITE.brand}</p>
        <p class="mt-2 text-sm leading-relaxed text-ink-400">
          OEM / ODM manufacturing of indoor air quality monitors for brands, importers and
          distributors.
        </p>
      </div>

      <nav aria-label="Footer" class="flex flex-col gap-3">
        {
          NAV.map((item) => (
            <a href={item.href} class="text-sm text-ink-300 transition-colors hover:text-ink-50">
              {item.label}
            </a>
          ))
        }
      </nav>
    </div>

    <p class="mt-10 border-t border-white/10 pt-6 text-xs text-ink-600">
      &copy; {year} {SITE.brand}. All rights reserved.
    </p>
  </div>
</footer>
