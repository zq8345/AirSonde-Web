---
import { NAV, SITE } from '../data/site';
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-ink-950/80 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-4 sm:px-8">
    <a href="/" class="flex items-center gap-2.5 text-ink-50">
      <span
        class="grid h-8 w-8 place-items-center rounded-lg bg-air-500/15 ring-1 ring-air-400/40"
        aria-hidden="true"
      >
        <span class="h-2.5 w-2.5 rounded-full bg-air-400"></span>
      </span>
      <span class="text-lg font-semibold tracking-tight">{SITE.brand}</span>
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-7 md:flex">
      {
        NAV.map((item) => (
          <a href={item.href} class="text-sm text-ink-300 transition-colors hover:text-ink-50">
            {item.label}
          </a>
        ))
      }
    </nav>

    <a
      href="#contact"
      class="rounded-lg bg-air-500 px-4 py-2 text-sm font-semibold text-ink-950 transition-colors hover:bg-air-400"
    >
      Get a quote
    </a>
  </div>
</header>
