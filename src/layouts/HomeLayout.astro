---
/**
 * Homepage v4 layout (Design System v1 — 真源 airsonde-design/home-v4.html).
 *
 * 🔴 The <head> below is LightBase.astro's head, line for line: title,
 * description, canonical/noindex, favicons, OG/Twitter, generator, and the
 * Organization + WebSite JSON-LD. The redesign changes the skin, not the
 * crawlable surface — diff the two heads and they must match.
 *
 * Only index.astro uses this layout this round. The other five pages stay
 * on LightBase + light.css untouched until their own design files arrive.
 */
import { Image } from 'astro:assets';
import '../styles/home-v4.css';
import { CONTACT_CHANNELS, CONTACT_V1, FOOTER_V4, HOME_V4, NAV, SITE } from '../data/site';
import { SCENES_DATA } from '../data/solutions';
import wechatQr from '../assets/photos/wechat-qr.webp';
import contentJson from '../data/site-content.json';
import { organisationSchema, websiteSchema } from '../lib/jsonld';
import wordmarkGreen from '../assets/airsonde-wordmark-green.png';
// Derived by scripts/build-wordmark-bright.mjs: same alpha, RGB = --green-bright.
import wordmarkBright from '../assets/airsonde-wordmark-bright.png';
import wordmarkWhite from '../assets/airsonde-wordmark-white.png';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  schemas?: Record<string, unknown>[];
  ogImage?: string;
  /** product detail: the last section is already wash, the footer sits flush (design: footer margin-top 0) */
  footerFlush?: boolean;
}

const {
  title = SITE.defaultTitle,
  description = SITE.defaultDescription,
  noindex = false,
  schemas = [],
  ogImage,
  footerFlush = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
const ogImageUrl = ogImage ? new URL(ogImage, SITE.url).href : undefined;
const allSchemas = [organisationSchema(), websiteSchema(), ...schemas];

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path === `${href}/` || path.startsWith(`${href}/`);
// DESIGN.md §6 (总工 2026-09-05): over the transparent header the wordmark is bright
// green on the homepage (Logo = Home = selected) and white on sub-page heroes; once
// the header turns white every page shows the brand-green wordmark.
const isHome = path === '/';
const logoOver = isHome ? wordmarkBright : wordmarkWhite;

// Footer v4 (Joe 2026-09-05, truth = about-v1.html <footer>). Every string is reused from an
// existing single source — nothing new was added to site-content.json (admin validator):
//   tagline = the homepage hero's two lines; Explore = NAV; Solutions = SCENES_DATA labels →
//   /solutions/<slug>/; Contact rows = contact.* values with the Contact page's labels and
//   channel hrefs; column headings live in site.ts FOOTER_V4.
const contact = contentJson.contact;
const L = CONTACT_V1.info.labels;
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}

    <link rel="icon" href="/favicon.svg?v=v11" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png?v=v11" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-192.png?v=v11" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=v11" />
    <meta name="theme-color" content="#ffffff" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en" />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

    <meta name="generator" content={Astro.generator} />

    {
      allSchemas.map((schema) => (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      ))
    }
  </head>

  <body>
    <a href="#main" class="skip">Skip to content</a>

    <header id="hd">
      <div class="wrap nav">
        <a class="logo-link" href="/" aria-label="Home">
          {/* Logo = Home, colour = state (Joe 2026-09-05): bright green (home) or white
              (sub-pages) over the dark hero, brand green once the header turns white. Two
              flat-colour assets, no filter, no opacity on the visible logo — a CSS crossfade. */}
          <Image class="logo-over" src={logoOver} alt={SITE.brand} widths={[240, 480]} sizes="120px" loading="eager" />
          <Image class="logo-green" src={wordmarkGreen} alt="" aria-hidden="true" widths={[240, 480]} sizes="120px" loading="eager" />
        </a>
        <nav aria-label="Primary">
          {
            NAV.map((item) => (
              <a
                href={item.href}
                class:list={{ on: isCurrent(item.href) }}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
        <button class="menu-btn" id="menuBtn" type="button" aria-label="Menu" aria-expanded="false" aria-controls="mnav">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path class="i-burger" d="M4 7h16M4 12h16M4 17h16" />
            <path class="i-x" d="M6 6l12 12M18 6L6 18" />
          </svg>
        </button>
        <div class="mnav" id="mnav">
          {
            NAV.map((item) => (
              <a href={item.href} class:list={{ on: isCurrent(item.href) }}>
                {item.label}
              </a>
            ))
          }
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class:list={{ 'footer--flush': footerFlush }}>
      <div class="wrap cols">
        <div class="brand">
          <Image src={wordmarkGreen} alt={SITE.brand} widths={[240, 480]} sizes="120px" loading="lazy" />
          <p>{HOME_V4.hero.headline}<br />{HOME_V4.hero.headlineEm}</p>
        </div>
        <div>
          <h4>{FOOTER_V4.explore}</h4>
          <ul>
            {NAV.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          </ul>
        </div>
        <div>
          <h4>{FOOTER_V4.solutions}</h4>
          <ul>
            {SCENES_DATA.map((scene) => <li><a href={`/solutions/${scene.slug}/`}>{scene.label}</a></li>)}
          </ul>
        </div>
        <div>
          <h4>{FOOTER_V4.contact}</h4>
          <ul>
            <li>{L.email} · <a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
            <li><a href={CONTACT_CHANNELS.whatsapp.href} target="_blank" rel="noopener">{L.whatsapp} · {CONTACT_CHANNELS.whatsapp.value}</a></li>
            <li class="fwx" tabindex="0" aria-describedby="fwxpop">
              {L.wechat} · {CONTACT_CHANNELS.phone.value}
              <div class="wxpop" id="fwxpop" role="tooltip">
                {/* 🔁 same replaceable asset as the Contact page: src/assets/photos/wechat-qr.webp */}
                <Image src={wechatQr} alt={CONTACT_V1.info.wechatScan} widths={[184, 368]} sizes="184px" loading="lazy" />
                <p>{CONTACT_V1.info.wechatScan}</p>
              </div>
            </li>
            <li>{L.address} · {contact.address}</li>
          </ul>
        </div>
      </div>
      <div class="bar">
        <div class="wrap">
          <span>&copy; {new Date().getFullYear()} {SITE.brand}. All rights reserved.</span>
        </div>
      </div>
    </footer>

    <script>
      // mobile menu (design: circular button, white panel)
      const mb = document.getElementById('menuBtn');
      const mn = document.getElementById('mnav');
      if (mb && mn) {
        const setOpen = (open: boolean) => {
          mn.classList.toggle('open', open);
          mb.setAttribute('aria-expanded', String(open));
        };
        mb.addEventListener('click', (e) => {
          e.stopPropagation();
          setOpen(!mn.classList.contains('open'));
        });
        document.addEventListener('click', (e) => {
          if (!mn.contains(e.target as Node) && e.target !== mb) setOpen(false);
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') setOpen(false);
        });
      }

      // header: transparent over the hero, white glass once scrolled (design: 60px)
      const hd = document.getElementById('hd');
      const onScroll = () => hd?.classList.toggle('sc', window.scrollY > 60);
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // reveal on scroll; reduced-motion users get everything shown at once
      const rv = document.querySelectorAll('.rv');
      if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const io = new IntersectionObserver(
          (es) =>
            es.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('in');
                io.unobserve(e.target);
              }
            }),
          { threshold: 0.12 },
        );
        rv.forEach((x) => io.observe(x));
      } else {
        rv.forEach((x) => x.classList.add('in'));
      }
    </script>
  </body>
</html>
