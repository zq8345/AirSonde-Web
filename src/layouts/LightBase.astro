---
/**
 * Light-theme layout for the W4 homepage sample ONLY.
 *
 * Head logic (title / meta / canonical / OG / JSON-LD) mirrors Base.astro so
 * the crawlable surface of the page is unchanged; only the skin differs.
 * The 15 untouched pages keep Base.astro — do not point them here before
 * Joe approves the sample.
 */
import { Image } from 'astro:assets';
import '../styles/light.css';
import { NAV, SITE } from '../data/site';
import { organisationSchema, websiteSchema } from '../lib/jsonld';
import wordmarkGreen from '../assets/airsonde-wordmark-green.png';

interface Props {
  title?: string;
  description?: string;
  /** Pages served at arbitrary URLs or still empty shells: no canonical, no indexing. */
  noindex?: boolean;
  schemas?: Record<string, unknown>[];
  /** Social preview image, absolute or root-relative (mirrors Base.astro). */
  ogImage?: string;
}

const {
  title = SITE.defaultTitle,
  description = SITE.defaultDescription,
  noindex = false,
  schemas = [],
  ogImage,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
const ogImageUrl = ogImage ? new URL(ogImage, SITE.url).href : undefined;
const allSchemas = [organisationSchema(), websiteSchema(), ...schemas];

// 0-a (Joe): the section you are in is marked in the nav — aria-current +
// styled state, wanew's behaviour. Prefix match covers /products/slug etc.
const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path === `${href}/` || path.startsWith(`${href}/`);
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}

    {/* ?v=v11 busts the cached old-logo icons — browsers hold favicons hard */}
    <link rel="icon" href="/favicon.svg?v=v11" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png?v=v11" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-192.png?v=v11" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=v11" />
    <meta name="theme-color" content="#ffffff" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en" />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

    <meta name="generator" content={Astro.generator} />

    {
      allSchemas.map((schema) => (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      ))
    }
  </head>

  <body>
    <a
      href="#main"
      style="position:absolute;left:-9999px;top:0;z-index:60"
      onfocus="this.style.left='16px';this.style.top='16px';this.style.background='#0c7a6b';this.style.color='#fff';this.style.padding='10px 16px';this.style.borderRadius='10px'"
      onblur="this.style.left='-9999px'"
    >
      Skip to content
    </a>

    <header class="as-header" id="as-header">
      <div class="as-header__in">
        {/* v11 wordmark (总工 定稿 2026-08-12) replaces the drawn mark + text */}
        <a href="/" class="as-brand" aria-label={SITE.brand}>
          <Image
            src={wordmarkGreen}
            alt={SITE.brand}
            class="as-brand__logo"
            widths={[240, 480]}
            sizes="150px"
            loading="eager"
          />
        </a>
        <nav aria-label="Primary" class="as-nav">
          {NAV.map((item) => (
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))}
        </nav>
        <a href="/contact" class="as-btn as-btn--primary">Get a quote</a>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="as-footer">
      <div class="as-container">
        <div class="as-footer__grid">
          <div>
            <span class="as-brand">
              <Image
                src={wordmarkGreen}
                alt={SITE.brand}
                class="as-brand__logo"
                widths={[240, 480]}
                sizes="150px"
                loading="lazy"
              />
            </span>
            <p class="as-footer__blurb">
              OEM / ODM manufacturing of indoor air quality monitors for brands, importers and
              distributors.
            </p>
          </div>
          <nav aria-label="Footer" class="as-footer__nav">
            {NAV.map((item) => <a href={item.href}>{item.label}</a>)}
            <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
          </nav>
        </div>
        <p class="as-footer__legal">&copy; {new Date().getFullYear()} {SITE.brand}. All rights reserved.</p>
      </div>
    </footer>

    <script>
      // §3.3: transparent header floats over the hero, drops onto white glass
      // once the page scrolls (threshold 12px, same as wanew's w3.js).
      const header = document.getElementById('as-header');
      const sync = () => header?.classList.toggle('is-solid', window.scrollY > 12);
      sync();
      window.addEventListener('scroll', sync, { passive: true });

      // §2.5 reveal — max 4 per screen, staggered by data-as-reveal level.
      const revealed = document.querySelectorAll('[data-as-reveal]');
      if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-in');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px' },
        );
        revealed.forEach((el) => io.observe(el));
      } else {
        revealed.forEach((el) => el.classList.add('is-in'));
      }
    </script>
  </body>
</html>
